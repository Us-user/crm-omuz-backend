# Скопируйте в `.env` и заполните значениями своего окружения.
# `.env` в git не попадает (см. .gitignore) — секреты только локально/в CI-секретах.

# --- Приложение ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_omuz?schema=public

# --- Redis ---
# Строка подключения целиком — так его выдают облачные провайдеры
# (Render Key Value, Upstash, Redis Cloud). Задана — перекрывает четыре
# переменные ниже. Схема rediss:// включает TLS.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Аутентификация (JWT) ---
# Секреты подписи: не менее 32 символов, разные для access и refresh.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# ТЗ 3.1: access — 1 час, refresh — 2 недели
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
# Секрет подписи одноразовых кодов сброса пароля (не менее 32 символов).
# Отдельный от JWT: именно он делает бесполезным перебор утёкшей таблицы кодов.
PASSWORD_RESET_SECRET=
# Регион по умолчанию для нормализации телефонов в E.164 (ISO 3166-1 alpha-2)
DEFAULT_PHONE_REGION=TJ

# --- Почта ---
# Адрес отправителя писем (код сброса пароля, приглашения).
# Реальный провайдер пока не подключён: письма пишутся в лог на уровне debug.
MAIL_FROM=no-reply@omuz.tj

# --- Часовой пояс центра и фоновые задачи ---
# Смещение центра от UTC в минутах (Таджикистан UTC+5 = 300). Именинников дня
# отбирают по календарю центра, а не по UTC.
CENTER_UTC_OFFSET_MINUTES=300
# Включены ли задачи по расписанию (поздравления с ДР, уборка доставок,
# автозакрытие месяца рейтинга). В тестах не регистрируются в любом случае.
SCHEDULED_TASKS_ENABLED=true

# --- Ограничение частоты запросов (ТЗ 3.8) ---
# Лимиты на вход, регистрацию, обновление токенов и сброс пароля. Считаются
# в Redis по двум ключам: адрес клиента и логин/почта из тела запроса.
# Недоступный Redis лимит не выключает — запросы в это время пропускаются
# без счёта, о чём приложение пишет предупреждение раз в минуту.
RATE_LIMIT_ENABLED=true

# --- Первый руководитель ---
# Заполните, если завести Director через `npm run seed:admin` нельзя —
# например, на площадке без доступа к shell (бесплатный план Render).
# Заданы все пять — приложение заводит руководителя при старте.
# Операция идемпотентная: существующий аккаунт не трогается, пароль
# не меняется. После первого входа переменные можно удалить.
# Пароль обязателен: при старте он не генерируется — показать его негде.
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_MIDDLE_NAME=
SEED_ADMIN_PASSWORD=

# --- Логи ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# --- HTTP ---
SWAGGER_ENABLED=true
# Список origin через запятую; пусто — CORS выключен
CORS_ORIGINS=http://localhost:5173
# ОБЯЗАТЕЛЬНО на проде за обратным прокси (nginx, балансировщик, HTTPS-терминатор):
# без этого адрес клиента равен адресу прокси — один на всех, и лимит по адресу
# закроет вход всему центру разом. `1` — доверять ровно ближайшему прокси.
# Понимает: true | false | <число хопов> | список адресов и подсетей через запятую.
# Пусто — настройка express не трогается (правильно для запуска без прокси).
TRUST_PROXY=
