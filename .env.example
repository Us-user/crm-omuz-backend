# Скопируйте в `.env` и заполните значениями своего окружения.
# `.env` в git не попадает (см. .gitignore) — секреты только локально/в CI-секретах.

# --- Приложение ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_omuz?schema=public

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Аутентификация (JWT) ---
# Секреты подписи: не менее 32 символов, разные для access и refresh.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# ТЗ 3.1: access — 1 час, refresh — 2 недели
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
# Секрет подписи одноразовых кодов сброса пароля (не менее 32 символов).
# Отдельный от JWT: именно он делает бесполезным перебор утёкшей таблицы кодов.
PASSWORD_RESET_SECRET=
# Регион по умолчанию для нормализации телефонов в E.164 (ISO 3166-1 alpha-2)
DEFAULT_PHONE_REGION=TJ

# --- Почта ---
# Адрес отправителя писем (код сброса пароля, приглашения).
# Реальный провайдер пока не подключён: письма пишутся в лог на уровне debug.
MAIL_FROM=no-reply@omuz.tj

# --- Логи ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# --- HTTP ---
SWAGGER_ENABLED=true
# Список origin через запятую; пусто — CORS выключен
CORS_ORIGINS=http://localhost:5173
