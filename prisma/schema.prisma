// Схема БД CRM «Omuz».
//
// Фаза 0 — только подключение и первая (пустая) миграция: она создаёт служебную
// таблицу `_prisma_migrations`, чтобы дальнейшие миграции ложились в общую историю.
// Доменные модели добавляются начиная с Фазы 1 (Account, Student, Employee, Session).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
