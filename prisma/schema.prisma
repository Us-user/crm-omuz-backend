// Схема БД CRM «Omuz».
//
// Фаза 1 — идентичность и аутентификация (ТЗ 3.1):
//   Account  — логин (телефон в E.164) + argon2id-хеш пароля;
//   Student / Employee — профили, взаимоисключающие, каждый опционально связан с Account;
//   Session  — серверные refresh-сессии (одна строка = одно устройство);
//   PasswordResetCode — одноразовый 6-значный код сброса пароля по email.
//
// Перевод Студент → Сотрудник (ТЗ 3.1): аккаунт переезжает с профиля студента
// на профиль сотрудника (`Employee.formerStudentId` хранит связь с прошлым),
// логин при этом не меняется, а строка `Student` со всей учебной историей живёт дальше.
//
// Фаза 2 — роли, позиции и права (ТЗ 3.2, 5.15):
//   Permission — каталог прав в нотации `Permission.<Раздел>.<Действие>`;
//   Position   — позиция сотрудника, она же роль доступа;
//   PositionPermission — «галочки» прав позиции;
//   EmployeePosition   — позиции сотрудника (мультивыбор), права = union прав позиций.
//
// Фаза 3 — учебный контур, справочники (ТЗ 5.6, 5.10, 5.17):
//   Branch — филиал; к нему привязаны аудитории, студенты и сотрудники (ТЗ 3.3);
//   Room   — аудитория филиала, источник поля «аудитория» в расписании;
//   Course — курс каталога: стоимость, длительность, флаг последнего курса;
//   Group  — учебная группа (ТЗ 5.5): курс + филиал + сроки + вместимость;
//   SyllabusLesson — урок программы курса («Day N», ТЗ 5.6);
//   SyllabusLessonGroup — «Show to group»: каким группам урок показан;
//   ResourceFile   — материал урока (ссылка на внешнее хранилище);
//   GroupMentor    — ментор группы с ролью Teaching/Support (ТЗ 5.5);
//   ScheduleSlot   — слот расписания группы: день недели + время + аудитория (ТЗ 5.5, 5.10).
//
//   GroupStudent   — членство студента в группе со своим статусом (ТЗ 5.5);
//                    оно же играет роль `Enrollment` из карты сущностей ТЗ 4.
//
// Фаза 4 — студенты (ТЗ 5.3):
//   Feedback — заметка сотрудника о студенте (карточка: Feedback / Edit / Block / Delete).
//   Приглашение (Invite) и блокировка (Block) новых таблиц не заводят: первое
//   создаёт обычный `Account`, вторая переводит `Account.status` и `Student.status`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Идентичность и доступ ───────────────────────────

/// Тип профиля, привязанного к аккаунту (ТЗ 3.1: Student ИЛИ Employee, не одновременно).
enum AccountType {
  STUDENT
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  /// Вход запрещён; обратимо, не удаление (ТЗ 5.3).
  BLOCKED
}

/// Язык интерфейса и уведомлений (ТЗ 3.3).
enum Locale {
  RU
  EN
  TG
}

enum Gender {
  MALE
  FEMALE
}

/// ТЗ 5.3: Active (учится) · No Active (пауза/покинул) · Finished (прошёл курс) · Block.
enum StudentStatus {
  ACTIVE
  NO_ACTIVE
  FINISHED
  BLOCK
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/// Идентичность: логин и пароль. Личные данные живут в профиле, потому что
/// профиль может существовать без аккаунта (ТЗ 5.3: «аккаунт опционален, Invite»).
model Account {
  id String @id @default(uuid()) @db.Uuid

  /// Логин. Номер телефона в формате E.164 (ТЗ 3.1).
  phone        String        @unique
  /// Нужен для сброса пароля по email (ТЗ 3.1), поэтому уникален.
  email        String        @unique
  passwordHash String
  type         AccountType
  status       AccountStatus @default(ACTIVE)
  locale       Locale        @default(RU)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student            Student?
  employee           Employee?
  sessions           Session[]
  passwordResetCodes PasswordResetCode[]

  @@index([status])
  @@map("accounts")
}

/// Профиль студента (ТЗ 5.3). Часть полей формы (филиал, группы) появится с Фазами 3–4.
model Student {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  birthDate DateTime? @db.Date
  gender    Gender?
  address   String?
  email     String?

  /// Контактный телефон в E.164. При регистрации совпадает с `Account.phone`.
  phone       String   @unique
  /// Телефон родителя/опекуна (ТЗ 3.1, поле регистрации).
  parentPhone String?
  /// Дополнительные телефоны (ТЗ 5.3).
  extraPhones String[] @default([])

  telegram String?
  photoUrl String?
  notes    String?

  /// Филиал, в котором учится студент (ТЗ 3.3, форма из ТЗ 5.3). Необязателен:
  /// профиль заводится раньше, чем становится известен филиал.
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status StudentStatus @default(ACTIVE)

  /// Сотрудник, которым стал этот студент (ТЗ 3.1: выпускник → ментор).
  /// Профиль студента при переводе не удаляется и не копируется — учебная
  /// история остаётся здесь, а связь позволяет её найти со стороны сотрудника.
  promotedEmployee Employee? @relation("StudentPromotion")

  /// Группы студента — действующие и закрытые (ТЗ 5.5, кабинет из ТЗ 5.3).
  /// Одновременно активным может быть одно членство на курс (решение сессии 0012):
  /// учиться на Frontend и English параллельно можно, в двух группах одного
  /// курса — нет.
  groups GroupStudent[]

  /// Заметки сотрудников о студенте (ТЗ 5.3: карточка — Feedback).
  feedback Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@index([branchId])
  @@map("students")
}

/// Профиль сотрудника (ТЗ 5.14).
model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  firstName  String
  lastName   String
  middleName String?
  birthDate  DateTime? @db.Date
  gender     Gender?
  address    String?
  email      String?

  /// Контактный телефон в E.164.
  phone String @unique

  telegram    String?
  photoUrl    String?
  description String?
  /// Опыт работы — свободный текст формы «Experience» (ТЗ 5.14).
  experience  String?

  /// Филиал сотрудника (ТЗ 3.3, форма из ТЗ 5.14).
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status  EmployeeStatus @default(ACTIVE)
  hiredAt DateTime?      @db.Date

  /// Студент, из которого вырос этот сотрудник (ТЗ 3.1). Заполняется переводом
  /// Студент → Сотрудник; уникален, потому что один профиль студента
  /// переводится ровно один раз.
  formerStudentId String?  @unique @db.Uuid
  formerStudent   Student? @relation("StudentPromotion", fields: [formerStudentId], references: [id], onDelete: SetNull)

  /// Позиции сотрудника (ТЗ 5.14: Position — мультивыбор). Права сотрудника —
  /// объединение прав всех этих позиций (ТЗ 3.2).
  positions EmployeePosition[]

  /// Группы, где сотрудник ведёт занятия или помогает (ТЗ 5.5).
  /// Отсюда же строится раздел «Groups» в профиле ментора (ТЗ 5.4).
  mentorGroups GroupMentor[]

  /// Занятия, которые сотрудник ведёт лично (ТЗ 5.10: ментор в расписании).
  /// Отсюда же берутся часы для расчёта зарплаты (ТЗ 5.16).
  mentorSlots ScheduleSlot[]

  /// Заметки, написанные этим сотрудником о студентах (ТЗ 5.3).
  authoredFeedback Feedback[] @relation("FeedbackAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@index([branchId])
  @@map("employees")
}

/// Серверная refresh-сессия (ТЗ 3.1): одна строка — одно устройство.
/// При ротации строка переиспользуется: в неё кладётся хеш нового refresh-токена,
/// поэтому старый токен автоматически перестаёт подходить.
model Session {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// SHA-256 (hex) от выданного refresh-токена. Сам токен не хранится.
  refreshTokenHash String

  userAgent String?
  ip        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Одноразовый код сброса пароля по email (ТЗ 3.1, 5.1): 6 цифр, ~10 минут,
/// не более 3 запросов в час и 3 попыток ввода на код.
///
/// Хранится HMAC-SHA256 с серверным секретом, а не сам код: пространство из 10^6
/// значений восстанавливается из обычного хеша мгновенно, если утечёт дамп БД,
/// а ключа HMAC в дампе нет (см. `ResetCodeService`).
model PasswordResetCode {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  codeHash String

  /// Сколько раз код вводили неверно. На пределе код гасится досрочно.
  attempts Int @default(0)

  expiresAt  DateTime
  /// Проставляется при успешном сбросе или при досрочном гашении кода.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Поиск живого кода аккаунта и подсчёт запросов за час.
  @@index([accountId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// ────────────────────────── Роли, позиции и права (RBAC) ─────────────────────────

/// Право из каталога (ТЗ 3.2), нотация `Permission.<Раздел>.<Действие>`.
///
/// Набор кодов — источник истины в **коде** (`src/rbac/permission-catalog.ts`),
/// а таблица хранит состояние переключателя и описание (ТЗ 5.15: «Permission — каталог
/// прав (toggle)»). Иначе опечатка в `@RequirePermission(...)` молча означала бы
/// право, которого нет ни у кого, — и эндпоинт стал бы недоступен вообще никому.
/// Строки приводятся к каталогу при старте приложения (`PermissionCatalogSyncService`).
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// Полный код целиком (`Permission.Students.Views`), чтобы строка в БД
  /// и строка в декораторе совпадали побайтово.
  code    String @unique
  section String
  action  String

  description String?

  /// Выключенное право не действует ни для одной позиции (toggle из ТЗ 5.15).
  isEnabled Boolean @default(true)

  /// Служебное право выключить нельзя: сняв управление каталогом прав,
  /// систему нельзя было бы починить через API.
  isSystem Boolean @default(false)

  positions PositionPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@map("permissions")
}

/// Позиция сотрудника (ТЗ 5.14), она же роль доступа из Administration → Users (ТЗ 5.15).
/// Термины «Role» и «Position» в ТЗ разведены, но сущность одна: права выдаются
/// только позициями (ТЗ 3.2), а вторая таблица создала бы второй источник прав.
model Position {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  /// Системную позицию нельзя удалить или переименовать: на `Director`
  /// опирается правило доступа к разделу Accounting (ТЗ 3.2).
  isSystem Boolean @default(false)

  permissions PositionPermission[]
  employees   EmployeePosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("positions")
}

/// Права позиции — те самые «галочки» из каталога (ТЗ 3.2).
model PositionPermission {
  positionId   String @db.Uuid
  permissionId String @db.Uuid

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([positionId, permissionId])
  /// Обратный обход: кто выдаёт это право (нужен при выключении права в каталоге).
  @@index([permissionId])
  @@map("position_permissions")
}

/// Назначение позиции сотруднику (ТЗ 5.14 — мультивыбор, ТЗ 5.15 — drawer «Add roles»).
model EmployeePosition {
  employeeId String @db.Uuid
  positionId String @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, positionId])
  /// Обратный обход: кто занимает позицию (список сотрудников позиции).
  @@index([positionId])
  @@map("employee_positions")
}

// ─────────────────────── Учебный контур: справочники (Фаза 3) ────────────────────

/// Состояние записи справочника. Выключенную запись не предлагают в новых
/// операциях, но она остаётся в истории — поэтому именно статус, а не удаление
/// (ТЗ 5.17: «статус» на карточке филиала).
///
/// Один enum на филиалы, аудитории и курсы: смысл у всех трёх один и тот же,
/// а три одинаковых перечисления пришлось бы держать в согласии руками.
enum DirectoryStatus {
  ACTIVE
  INACTIVE
}

/// Единица длительности курса (ТЗ 5.6 «Duration»; ТЗ 5.5 — «длительность: число + тип»).
/// Тот же тип понадобится группам, поэтому он общий, а не встроен в курс.
enum DurationUnit {
  DAY
  WEEK
  MONTH
}

/// Филиал центра (ТЗ 5.17). Мультифилиальность сквозная (ТЗ 3.3): к филиалу
/// привязаны аудитории, студенты и сотрудники, а позже — группы.
model Branch {
  id String @id @default(uuid()) @db.Uuid

  /// Название филиала (Sadbarg, Profsous…). Уникально: по нему филиал узнают на экранах.
  name String @unique

  city     String
  /// Район города — отдельным полем, потому что карточка филиала показывает его
  /// рядом с городом (ТЗ 5.17), а не внутри строки адреса.
  district String?
  address  String

  /// Телефон филиала в E.164. Не уникален: несколько филиалов могут делить один номер.
  phone String?

  description String?
  status      DirectoryStatus @default(ACTIVE)

  rooms     Room[]
  students  Student[]
  employees Employee[]
  groups    Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("branches")
}

/// Аудитория (ТЗ 5.10): источник поля «Room» в расписании занятий.
/// Комната физически принадлежит филиалу, поэтому связь обязательна.
model Room {
  id String @id @default(uuid()) @db.Uuid

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name String

  /// Сколько человек помещается. Понадобится при проверке вместимости группы.
  capacity Int?
  floor    Int?

  description String?
  status      DirectoryStatus @default(ACTIVE)

  /// Занятия, поставленные в этой аудитории (ТЗ 5.10). `RESTRICT` со стороны
  /// слота: аудиторию, занятую в расписании, удалить нельзя (см. `RoomsService`).
  scheduleSlots ScheduleSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Название уникально внутри филиала, а не глобально: аудитория «101»
  /// вполне может быть в каждом филиале.
  @@unique([branchId, name])
  @@index([branchId])
  @@index([status])
  @@map("rooms")
}

/// Курс каталога (ТЗ 5.6). Курсы длятся около месяца, поэтому `fee` —
/// одновременно и помесячное начисление в бухгалтерии (ТЗ 5.16).
model Course {
  id String @id @default(uuid()) @db.Uuid

  title       String  @unique
  subtitle    String?
  description String?

  /// Стоимость курса в сомони (ТЗ 1: валюта TJS). `Decimal`, а не `Float`:
  /// деньги в двоичной плавающей точке накапливают ошибку на сложении.
  fee Decimal @db.Decimal(12, 2)

  /// «Is last course» из ТЗ 5.6: завершение группы такого курса запускает
  /// автовыпуск студентов (ТЗ 5.11).
  isLastCourse Boolean @default(false)

  /// Цвета карточки курса на экранах (Color1/Color2 из ТЗ 5.6), формат `#RRGGBB`.
  colorPrimary   String?
  colorSecondary String?
  logoUrl        String?

  /// Длительность = число + единица (ТЗ 5.6). Хранится парой, а не строкой,
  /// чтобы по ней можно было считать даты окончания групп.
  durationValue Int
  durationUnit  DurationUnit @default(MONTH)

  status DirectoryStatus @default(ACTIVE)

  /// Группы, которые учатся по этому курсу (ТЗ 5.6: «кол-во групп» на карточке).
  groups Group[]

  /// Программа курса (ТЗ 5.6 «Syllabus»). Урок без курса не имеет смысла,
  /// поэтому связь каскадная: удаление курса уносит и его программу.
  lessons SyllabusLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  /// Автовыпуск ищет курсы с флагом последнего — выборка по одному значению.
  @@index([isLastCourse])
  @@map("courses")
}

/// Формат занятий (ТЗ 5.5: Online/Offline).
enum GroupFormat {
  ONLINE
  OFFLINE
}

/// Жизненный цикл группы. ТЗ 5.5 требует поле «статус» и фильтр по нему,
/// но самого перечисления не даёт (в отличие от статусов студента из ТЗ 5.3),
/// поэтому набор выбран решением пользователя (сессия 0008).
enum GroupStatus {
  /// Идёт набор: студентов добирают до вместимости («Required students», ТЗ 5.5).
  RECRUITING
  /// Занятия идут.
  ACTIVE
  /// Срок вышел. Для группы курса с «Is last course» это точка автовыпуска (ТЗ 5.11).
  FINISHED
  /// Группа не состоялась. Отличается от `FINISHED`: обучения не было.
  CANCELLED
}

/// Учебная группа (ТЗ 5.5) — то, к чему сходится весь учебный контур:
/// журнал (ТЗ 5.8), расписание (ТЗ 5.10) и состав студентов ссылаются на неё.
///
/// Курс и филиал обязательны: группа без курса не имеет программы, а без филиала
/// не попадает ни в фильтр «Branch», ни в разрез мультифилиальности (ТЗ 3.3).
/// Обе связи — `RESTRICT`: удаление курса или филиала, за которым числятся
/// группы, отклоняется с объяснением (см. `CoursesService`, `BranchesService`).
model Group {
  id String @id @default(uuid()) @db.Uuid

  name        String
  description String?

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  format GroupFormat @default(OFFLINE)

  /// Сроки обучения. `endDate` можно не передавать: он считается из `startDate`
  /// и длительности — именно ради этого длительность хранится парой «число + единица».
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Длительность группы (ТЗ 5.5: «число + тип»). Может отличаться от длительности
  /// курса: одну и ту же программу растягивают или сжимают под расписание набора.
  durationValue Int?
  durationUnit  DurationUnit @default(MONTH)

  /// «Required students» из ТЗ 5.5 — сколько человек набирают в группу.
  /// Само «набрано/вместимость» посчитается, когда появится состав группы.
  capacity Int?

  status GroupStatus @default(RECRUITING)

  /// Ссылка на групповой чат (ТЗ 5.5: «Telegram-ссылка»).
  telegramUrl String?

  /// Уроки силлабуса, открытые этой группе («Show to group», ТЗ 5.6).
  visibleLessons SyllabusLessonGroup[]

  /// Менторы группы (ТЗ 5.5: «менторы (несколько, роли Teaching/Support)»).
  mentors GroupMentor[]

  /// Расписание группы (ТЗ 5.5: «слоты день+время → Timetable»).
  schedule ScheduleSlot[]

  /// Состав группы (ТЗ 5.5). «Набрано» из «Required students» — это активные
  /// членства, поэтому счётчик в карточке считается с фильтром по статусу.
  students GroupStudent[]

  /// Членства, переведённые **из** этой группы в другие (ТЗ 5.5: Transfer).
  /// Обратная сторона `GroupStudent.transferredFromGroup`; отдельного экрана
  /// у неё нет, но без неё Prisma не назовёт вторую связь на ту же модель.
  transferredStudents GroupStudent[] @relation("GroupStudentTransfer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Название уникально внутри филиала, как у аудиторий: «Frontend-1» набирают
  /// в каждом филиале, а глобальная уникальность заставила бы придумывать
  /// «Sadbarg-Frontend-1». Отдельного `@@index([branchId])` нет намеренно —
  /// фильтр по филиалу обслуживается крайним левым столбцом этого же индекса.
  @@unique([branchId, name])
  @@index([courseId])
  @@index([status])
  /// Под фильтры и отчёты по датам (ТЗ 7).
  @@index([startDate])
  @@map("groups")
}

// ───────────────────── Силлабус курса и материалы (ТЗ 5.6) ────────────────────

/// Тип занятия (ТЗ 5.6: Lecture / Practice / Exam).
///
/// `EXAM` здесь не просто ярлык: в журнале (ТЗ 5.8) на экзаменационном дне
/// приход не начисляется, а балл идёт отдельным слагаемым `Exam`.
enum LessonType {
  LECTURE
  PRACTICE
  EXAM
}

/// Раздел урока, к которому относится материал (ТЗ 5.6: «файлы (Lecture/Practice/Homework)»).
/// Отвечает на вопрос «зачем этот файл», а не «что это за файл».
enum ResourceKind {
  LECTURE
  PRACTICE
  HOMEWORK
}

/// `ResourceFileType` из ТЗ 5.6 — чем является сам материал. Отвечает
/// на вопрос «что это за файл» и нужен экрану, чтобы выбрать иконку
/// и способ открытия (скачать / проиграть / перейти по ссылке).
enum ResourceFileType {
  PDF
  DOC
  SLIDES
  SPREADSHEET
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  /// Внешняя страница, а не файл (например, статья или репозиторий).
  LINK
  OTHER
}

/// Урок программы курса — «Day N» из ТЗ 5.6.
///
/// Номер дня **не уникален** внутри курса намеренно: в один учебный день
/// вполне может стоять и лекция, и практика, а запрет на второй урок с тем же
/// номером был бы придуманным правилом, которое оператору нечем обойти.
/// Поэтому номер — это порядок в списке, а не идентификатор урока.
model SyllabusLesson {
  id String @id @default(uuid()) @db.Uuid

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Номер учебного дня внутри курса («Day 1», «Day 2»…).
  dayNumber Int

  title       String
  description String?

  type   LessonType      @default(LECTURE)
  status DirectoryStatus @default(ACTIVE)

  /// Материалы урока (ТЗ 5.6). Каскад: файл вне урока адресовать нечем.
  files ResourceFile[]

  /// «Show to group» (ТЗ 5.6) — мультивыбор групп, которым урок открыт.
  visibleToGroups SyllabusLessonGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Программа курса всегда читается целиком и в порядке дней — этого индекса
  /// хватает и на выборку, и на сортировку. Отдельных индексов по `status`
  /// и `type` нет: любая выборка уже сужена курсом, внутри курса уроков десятки.
  @@index([courseId, dayNumber])
  @@map("syllabus_lessons")
}

/// «Show to group» (ТЗ 5.6): какой группе показан какой урок.
///
/// Каскад с обеих сторон — это настройка видимости, а не данные: удалённая
/// группа не должна оставлять за собой строки, а восстанавливать «кому был
/// показан урок» удалённой группы незачем.
model SyllabusLessonGroup {
  lessonId String @db.Uuid
  groupId  String @db.Uuid

  lesson SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([lessonId, groupId])
  /// Обратный обход: что открыто этой группе (экран «Material» ментора, ТЗ 5.4).
  @@index([groupId])
  @@map("syllabus_lesson_groups")
}

/// Материал урока (ТЗ 5.6: «Resource: Title/Type/ResourceFileType»).
///
/// Хранится **ссылка** на внешнее хранилище, а не сам файл (решение сессии 0009,
/// как `Course.logoUrl`): приём загрузок — отдельный сквозной кусок
/// инфраструктуры, и модель к нему готова без миграции.
model ResourceFile {
  id String @id @default(uuid()) @db.Uuid

  lessonId String         @db.Uuid
  lesson   SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title String

  /// Зачем файл (Lecture/Practice/Homework) и что это за файл — два разных
  /// вопроса, и ТЗ 5.6 перечисляет их отдельно («Type» и «ResourceFileType»).
  kind     ResourceKind     @default(LECTURE)
  fileType ResourceFileType @default(OTHER)

  url         String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@map("resource_files")
}

// ────────────────────────── Менторы группы (ТЗ 5.5) ──────────────────────────

/// Роль ментора в группе (ТЗ 5.5: «менторы (несколько, роли Teaching/Support)»).
enum GroupMentorRole {
  /// Ведёт занятия. Именно по часам этой роли считается зарплата ментора
  /// («часы по фактически проведённым занятиям × ставка», ТЗ 5.16).
  TEACHING
  /// Помогает на занятиях: разбирает задачи, подхватывает отстающих.
  SUPPORT
}

/// Ментор группы (ТЗ 5.5). У группы их несколько, у каждого своя роль.
///
/// Позиция «Mentor» для назначения **не требуется** (решение сессии 0010):
/// правило пришлось бы опирать на название позиции, а название редактируется
/// администратором (`/positions`), и `Mentor` не помечена `isSystem` — как
/// только позицию переименовали бы, назначение менторов молча сломалось бы.
/// Заодно руководитель, который сам ведёт занятия, не попадает под запрет.
///
/// Каскады с обеих сторон: назначение — это связь, а не самостоятельная запись
/// со своей историей (как `EmployeePosition`). Удалять группу или сотрудника
/// ради сохранения строки о назначении незачем.
model GroupMentor {
  groupId    String @db.Uuid
  employeeId String @db.Uuid

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  role GroupMentorRole @default(TEACHING)

  assignedAt DateTime @default(now())

  /// Один сотрудник в группе ровно один раз: две роли одновременно означали бы,
  /// что часы занятия посчитаны дважды. Роль меняется правкой назначения.
  @@id([groupId, employeeId])
  /// Обратный обход: группы конкретного ментора (раздел «Groups» профиля, ТЗ 5.4).
  @@index([employeeId])
  @@map("group_mentors")
}

// ───────────────────────── Расписание группы (ТЗ 5.5, 5.10) ─────────────────────

/// День недели слота расписания.
///
/// Порядок объявления — это и порядок сортировки типа в PostgreSQL, поэтому
/// неделя читается сверху вниз без отдельного поля порядка. Неделя начинается
/// с понедельника: так её показывают календари в ru/tg-локалях.
enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Слот расписания группы (ТЗ 5.5: «расписание (слоты день+время → Timetable)»).
///
/// Слот **повторяется еженедельно** в пределах сроков группы (решение сессии 0011):
/// «Понедельник 10:00–12:00 в аудитории 101» — одна строка на весь курс, а не
/// по строке на каждое занятие. Календарь Day/Week/Month (ТЗ 5.10) разворачивает
/// слоты в конкретные даты на лету.
///
/// Тип занятия (Lecture/Practice/Exam) слоту не принадлежит намеренно: при
/// еженедельном повторении каждый понедельник — это другой день программы,
/// и тип берётся из силлабуса (`SyllabusLesson.type`), а не из слота.
model ScheduleSlot {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  dayOfWeek WeekDay

  /// Начало и конец занятия — минуты от полуночи (0…1439), а не `time`.
  /// Целое число сравнимо и сортируемо без разбора часовых поясов, а Prisma
  /// отдаёт `@db.Time` как `DateTime` с фиктивной датой — на нём проверка
  /// пересечений читалась бы хуже, чем на числах. Наружу уходит `HH:MM`.
  startMinute Int
  endMinute   Int

  /// Аудитория занятия (ТЗ 5.10). Необязательна: у онлайн-группы её нет.
  /// `RESTRICT`: аудитория — самостоятельная запись справочника, и её удаление
  /// не должно молча стирать занятия из расписания (как филиал и курс).
  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// Кто ведёт это занятие (ТЗ 5.10 показывает ментора в календаре).
  /// Только из числа менторов группы — проверяется сервисом; в БД связь идёт
  /// на сотрудника, а не на `GroupMentor`, потому что `SET NULL` по составному
  /// ключу обнулил бы заодно и `groupId`. При снятии ментора с группы поле
  /// очищается той же транзакцией (`GroupMentorsRepository.delete`).
  mentorId String?   @db.Uuid
  mentor   Employee? @relation(fields: [mentorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Расписание группы читается целиком и в порядке «день недели, время».
  @@index([groupId, dayOfWeek, startMinute])
  /// Поиск пересечений: занята ли аудитория и не ведёт ли ментор другое занятие.
  @@index([roomId, dayOfWeek])
  @@index([mentorId, dayOfWeek])
  @@map("schedule_slots")
}

// ───────────────────────── Состав группы (ТЗ 5.5, 5.12) ─────────────────────────

/// Статус участия студента в группе (ТЗ 5.5: «массовые Change status
/// (с обязательной причиной = Reason)»).
///
/// Это статус **членства**, а не самого студента (`Student.status`, ТЗ 5.3):
/// студент может параллельно учиться на другом курсе, и уход из одной группы
/// не означает, что он ушёл из центра. Решение сессии 0012.
enum GroupStudentStatus {
  /// Учится в группе. Считается в «набрано» из «Required students» (ТЗ 5.5).
  ACTIVE
  /// Покинул курс, не завершив его. Ровно эти записи и есть «Left courses»
  /// из ТЗ 5.12: группа на момент ухода, причина и дата лежат здесь же.
  LEFT
  /// Прошёл обучение в группе до конца (ТЗ 5.3: статус студента Finished).
  FINISHED
  /// Переведён в другую группу (ТЗ 5.5: Transfer). Отдельный статус, а не `LEFT`:
  /// переведённый не покинул центр, и в отчёт по покинувшим он попадать не должен.
  TRANSFERRED
}

/// Студент в составе группы (ТЗ 5.5: «состав студентов»).
///
/// Эта же строка играет роль `Enrollment` из карты сущностей ТЗ 4: заводить
/// вторую таблицу «история зачислений» значило бы держать два источника истины
/// об одном и том же (решение сессии 0012). История сохраняется тем, что
/// закрытые членства (`LEFT`/`FINISHED`/`TRANSFERRED`) не удаляются, а остаются
/// со своей причиной и датой.
///
/// Каскады с обеих сторон — как у `GroupMentor`: членство это связь, а не
/// самостоятельная запись. Удаление группы при этом упирается в проверку
/// сервиса (409), чтобы учебная история не исчезала молча.
model GroupStudent {
  groupId   String @db.Uuid
  studentId String @db.Uuid

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status GroupStudentStatus @default(ACTIVE)

  /// Причина смены статуса (ТЗ 5.5: Reason обязателен; ТЗ 5.12: «причина —
  /// свободный текст»). У только что зачисленного студента причины нет.
  statusReason    String?
  /// Когда статус меняли в последний раз (ТЗ 5.12: «причина и дата»).
  statusChangedAt DateTime?

  /// Откуда студент переведён сюда (ТЗ 5.5: Transfer). `SET NULL`: удаление
  /// прежней группы не должно уносить действующее членство в новой.
  transferredFromGroupId String? @db.Uuid
  transferredFromGroup   Group?  @relation("GroupStudentTransfer", fields: [transferredFromGroupId], references: [id], onDelete: SetNull)

  enrolledAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один студент в группе ровно один раз. Вернувшийся в ту же группу занимает
  /// прежнюю строку, а не заводит вторую: «дважды в одной группе» не значит
  /// ничего, а правило «одно активное членство на курс» держит сервис —
  /// частичный уникальный индекс Prisma не выражает.
  @@id([groupId, studentId])
  /// Обратный обход: группы конкретного студента (кабинет студента, ТЗ 5.3).
  @@index([studentId])
  /// Под «набрано/вместимость» и выборку покинувших курс (ТЗ 5.5, 5.12).
  @@index([groupId, status])
  @@index([transferredFromGroupId])
  @@map("group_students")
}

/// Обратная связь по студенту (ТЗ 5.3: карточка — Feedback / Edit / Block / Delete).
///
/// Заметка сотрудника о студенте: наблюдение ментора, разговор с родителями,
/// причина пропусков. Это не оценка: успеваемость и рейтинг считаются
/// по журналу (ТЗ 5.8), и вторая шкала конкурировала бы с ними.
model Feedback {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Автор заметки. Необязателен: профиль сотрудника может быть удалён (ТЗ 5.14),
  /// но заметка остаётся — она про студента, а не про того, кто её написал.
  authorId String?   @db.Uuid
  author   Employee? @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Заметки читаются лентой по студенту, свежие сверху.
  @@index([studentId, createdAt])
  /// Обратный обход: что писал конкретный сотрудник.
  @@index([authorId])
  @@map("student_feedback")
}
