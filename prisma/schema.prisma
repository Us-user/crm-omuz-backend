// ─────────────────────────── Фаза 12 — Генерация документов ───────────────────────────

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

/// Договор обучения студента (ТЗ 3.7, 5.3).
model Contract {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @db.Uuid
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contractNumber String         @unique
  title          String
  issuedAt       DateTime       @db.Date
  validUntil     DateTime?      @db.Date
  status         ContractStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("contracts")
}

// ───────────────────────── Фаза 13 — Аудит действий (ТЗ 3.6) ─────────────────────────

/// Строка журнала действий: кто, что, когда (ТЗ 3.6, 5.15 «Administration → Logs»).
///
/// Пишется перехватчиком после **изменяющего** запроса (POST/PUT/PATCH/DELETE):
/// чтения в журнал не попадают — дашборд и списки опрашиваются постоянно, и их
/// записи похоронили бы настоящие действия под шумом.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Кто — ссылка на аккаунт. `SET NULL`, поэтому рядом лежит снимок: после
  /// удаления сотрудника ссылка обнулится, а журнал обязан остаться читаемым.
  accountId String?  @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// Имя, телефон и тип действующего лица **снимком** — приём `Notification`
  /// (0036), `MonthlyWinner` (0024) и `Graduate.points` (0026): запись о прошлом
  /// не должна меняться вслед за профилем и не должна исчезать вместе с ним.
  actorName  String?
  actorPhone String?
  actorType  AccountType?

  /// Что: код действия. Берётся из права каталога без префикса (`Students.Create`),
  /// то есть второго перечня действий в проекте не заводится.
  action String

  /// Метод и **шаблон** маршрута (`/api/v1/students/:id`), а не адрес запроса:
  /// в адресе стоят подставленные значения и строка поиска — персональные данные,
  /// которых в журнале быть не должно.
  method String
  path   String

  /// Над чем: идентификатор из пути, а у создания — из ответа обработчика.
  /// Не `@db.Uuid`: ключом бывает и месяц (`DELETE /leaders/winners/2026-07`).
  entityId String?

  /// Код ответа. Исход (успех/отказ) из него **выводится**, а не хранится
  /// колонкой: два источника истины об одном и том же разошлись бы (0012, 0019,
  /// 0025, 0026, 0029–0033, 0036, 0037).
  statusCode Int

  /// Сквозная трассировка: тот же `x-request-id`, что в логах Pino и в теле
  /// ошибки (0001) — по нему строка журнала связывается с полным логом запроса.
  requestId String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  /// Экран Logs читается по датам (ТЗ 5.15), а фильтры «кто» и «что» всегда
  /// идут вместе с порядком по времени — отсюда составные индексы.
  @@index([createdAt])
  @@index([accountId, createdAt])
  @@index([action, createdAt])
  @@index([entityId])
  @@map("audit_logs")
}


// ────────────────────────── Фаза 13 — Вакансии (ТЗ 5.18) ──────────────────────────

/// Вакансия учебного центра (ТЗ 5.18: «ручной список актуальных вакансий,
/// CRUD админом»).
///
/// Состав полей ТЗ называет приблизительно («уточняются: название, описание,
/// компания, требования, контакты, срок»), поэтому здесь ровно эти шесть
/// и ни одного сверх: зарплата, формат занятости и город — правдоподобные
/// догадки, а не требование, и заводить колонку под догадку значило бы
/// обещать экран, которого никто не заказывал.
///
/// **Уникальности нет ни у одного поля** — осознанно иначе, чем у купона
/// (0027), филиала (0007) и позиции (0006): «Frontend-разработчик» бывает
/// одновременно у двух компаний, а одна компания открывает ту же вакансию
/// каждые полгода. Запрет вычёркивал бы законные записи, как запрет повторного
/// телефона вычёркивал бы повторное обращение лида (0027).
model Job {
  id String @id @default(uuid()) @db.Uuid

  /// Название вакансии («Frontend-разработчик»).
  title String

  /// Работодатель. Обязателен: вакансия без компании не отвечает на первый же
  /// вопрос читателя — куда, собственно, идти.
  company String

  description  String?
  requirements String?

  /// Как откликнуться — свободный текст (телефон, почта, Telegram, имя
  /// рекрутёра). Обязателен по той же причине, что и компания: список,
  /// по которому нельзя откликнуться, не является списком вакансий.
  ///
  /// Одной колонкой, а не тремя (`contactPhone`/`contactEmail`/…): ТЗ называет
  /// «контакты» одним полем, разбор строки центру не нужен (рассылок по этим
  /// адресам нет), а три необязательные колонки на месте одной обязательной
  /// разрешили бы вакансию вообще без способа связи.
  contacts String

  /// Срок приёма откликов (ТЗ 5.18: «срок»). Необязателен: бессрочный набор —
  /// законное состояние, и подставлять ему выдуманный конец значило бы погасить
  /// вакансию в неизвестный день (то же соображение, что с периодом купона, 0027).
  ///
  /// Граница **включающая**: вакансия «до 30 ноября» открыта тридцатого.
  deadline DateTime? @db.Date

  /// Active/Inactive — общий `DirectoryStatus` (0007). Стоит **рядом** со сроком,
  /// а не вместо него: место закрывают раньше объявленного срока чаще, чем
  /// доводят до него, и единственным способом снять такую вакансию иначе было
  /// бы удаление (то есть потеря истории) или подделка даты задним числом.
  ///
  /// «Актуальна ли вакансия» отдельной колонкой не хранится: это статус плюс
  /// сравнение срока с сегодняшним днём (`isJobOpen`), и третья копия того же
  /// факта разошлась бы с датами в первый же день — тринадцатый раз тот же
  /// разбор после 0012, 0019, 0025, 0026, 0029–0033, 0036, 0037, 0038.
  status DirectoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Экран читается «что открыто» и «что скоро закроется» — отсюда оба индекса.
  @@index([status])
  @@index([deadline])
  @@map("jobs")
}
