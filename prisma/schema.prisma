// Схема БД CRM «Omuz».
//
// Фаза 1 — идентичность и аутентификация (ТЗ 3.1):
//   Account  — логин (телефон в E.164) + argon2id-хеш пароля;
//   Student / Employee — профили, взаимоисключающие, каждый опционально связан с Account;
//   Session  — серверные refresh-сессии (одна строка = одно устройство);
//   PasswordResetCode — одноразовый 6-значный код сброса пароля по email.
//
// Перевод Студент → Сотрудник (ТЗ 3.1): аккаунт переезжает с профиля студента
// на профиль сотрудника (`Employee.formerStudentId` хранит связь с прошлым),
// логин при этом не меняется, а строка `Student` со всей учебной историей живёт дальше.
//
// Фаза 2 — роли, позиции и права (ТЗ 3.2, 5.15):
//   Permission — каталог прав в нотации `Permission.<Раздел>.<Действие>`;
//   Position   — позиция сотрудника, она же роль доступа;
//   PositionPermission — «галочки» прав позиции;
//   EmployeePosition   — позиции сотрудника (мультивыбор), права = union прав позиций.
//
// Фаза 3 — учебный контур, справочники (ТЗ 5.6, 5.10, 5.17):
//   Branch — филиал; к нему привязаны аудитории, студенты и сотрудники (ТЗ 3.3);
//   Room   — аудитория филиала, источник поля «аудитория» в расписании;
//   Course — курс каталога: стоимость, длительность, флаг последнего курса;
//   Group  — учебная группа (ТЗ 5.5): курс + филиал + сроки + вместимость;
//   SyllabusLesson — урок программы курса («Day N», ТЗ 5.6);
//   SyllabusLessonGroup — «Show to group»: каким группам урок показан;
//   ResourceFile   — материал урока (ссылка на внешнее хранилище);
//   GroupMentor    — ментор группы с ролью Teaching/Support (ТЗ 5.5);
//   ScheduleSlot   — слот расписания группы: день недели + время + аудитория (ТЗ 5.5, 5.10).
//
//   GroupStudent   — членство студента в группе со своим статусом (ТЗ 5.5);
//                    оно же играет роль `Enrollment` из карты сущностей ТЗ 4.
//
// Фаза 4 — студенты (ТЗ 5.3):
//   Feedback — заметка сотрудника о студенте (карточка: Feedback / Edit / Block / Delete).
//   Parent / StudentParent — родители и опекуны (ТЗ 4): запись общая, узнаётся
//   по телефону, степень родства лежит на связке. Колонка `Student.parentPhone`
//   при их появлении убрана — она стала бы вторым источником истины о контакте.
//   Приглашение (Invite) и блокировка (Block) новых таблиц не заводят: первое
//   создаёт обычный `Account`, вторая переводит `Account.status` и `Student.status`.
//
// Фаза 5 — журнал, успеваемость и коины (ТЗ 5.8, 5.9):
//   JournalWeek  — неделя журнала группы («NEW WEEK»), финализируемая «Отправить результат»;
//   JournalDay   — учебный день недели с типом занятия (на `EXAM` приход не начисляется);
//   JournalEntry — клетка «студент × день»: Att + Score (ДЗ ≤5);
//   WeekResult   — итог недели по студенту: Bonus / Exam / Sum;
//   CoinBalance / CoinTransaction — коины: ручное начисление и авто по итогам недели.
//
// Фаза 6 — сотрудники и менторы (ТЗ 5.14, 5.4):
//   MentorLevel        — справочник ступеней ментора: уровень + часовая ставка;
//   MentorLevelHistory — уровень сотрудника **по месяцам**: зарплата считается
//                        по ставке уровня того месяца, за который начисляется (ТЗ 5.16).
//   AvansRequest       — заявка на аванс; рассмотрение — бухгалтерия Фазы 9.
//
// Фаза 7 — завершение жизненного цикла и рейтинги (ТЗ 5.11, 5.12, 5.13):
//   MonthlyWinner — снимок победителей месяца; Graduate — выпуск с курса
//   вместе с замороженным баллом и серийным номером сертификата.
//   `LeftCourse`, `Certificate`, `StudentActivityCategory` и `Performance`
//   из карты сущностей ТЗ 4 осознанно **не заводились**: каждый оказался вторым
//   источником истины о том, что уже выражено (см. комментарии у моделей).
//
// Фаза 8 — маркетинговый контур (ТЗ 5.7):
//   Lead   — обращение в центр: Lead до пробного дня, Client после него;
//            переведённый в студенты не удаляется, а хранит ссылку на профиль,
//            иначе воронка (ТЗ 5.2) теряла бы свой правый конец;
//   Coupon / CouponCourse — купон: сумма в сомони, период, Active/Inactive
//            и мультивыбор курсов («курс(ы)» из ТЗ 5.7).
//
// Фаза 9 — бухгалтерия, платёжный контур (ТЗ 5.16, только Director):
//   PaymentType        — справочник способов оплаты («тип Cash/Alif»);
//   StudentPayment     — помесячное начисление студенту: снимок Fee курса
//                        за (студент, группа, месяц), плюс скидка с причиной;
//   PaymentTransaction — полученные деньги: платёж по начислению либо
//                        **предоплата** (`chargeId = null`).
//   `Debtor` из карты сущностей ТЗ 4 **не заводится**: долг это разница
//   «начислено − оплачено» по тем же двум таблицам, и третья стала бы вторым
//   источником истины о том же числе (тот же разбор, что с `Enrollment`,
//   `Performance`, `LeftCourse` и `Certificate`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Идентичность и доступ ───────────────────────────

/// Тип профиля, привязанного к аккаунту (ТЗ 3.1: Student ИЛИ Employee, не одновременно).
enum AccountType {
  STUDENT
  EMPLOYEE
}

enum AccountStatus {
  ACTIVE
  /// Вход запрещён; обратимо, не удаление (ТЗ 5.3).
  BLOCKED
}

/// Язык интерфейса и уведомлений (ТЗ 3.3).
enum Locale {
  RU
  EN
  TG
}

enum Gender {
  MALE
  FEMALE
}

/// ТЗ 5.3: Active (учится) · No Active (пауза/покинул) · Finished (прошёл курс) · Block.
enum StudentStatus {
  ACTIVE
  NO_ACTIVE
  FINISHED
  BLOCK
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/// Идентичность: логин и пароль. Личные данные живут в профиле, потому что
/// профиль может существовать без аккаунта (ТЗ 5.3: «аккаунт опционален, Invite»).
model Account {
  id String @id @default(uuid()) @db.Uuid

  /// Логин. Номер телефона в формате E.164 (ТЗ 3.1).
  phone        String        @unique
  /// Нужен для сброса пароля по email (ТЗ 3.1), поэтому уникален.
  email        String        @unique
  passwordHash String
  type         AccountType
  status       AccountStatus @default(ACTIVE)
  locale       Locale        @default(RU)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student            Student?
  employee           Employee?
  sessions           Session[]
  passwordResetCodes PasswordResetCode[]

  /// Действия этого аккаунта (ТЗ 3.6). Ссылка `SET NULL`: удаление аккаунта
  /// не уносит журнал — «кто это был» держит снимок в самой строке.
  auditLogs AuditLog[]

  @@index([status])
  @@map("accounts")
}

/// Профиль студента (ТЗ 5.3). Часть полей формы (филиал, группы) появится с Фазами 3–4.
model Student {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  birthDate DateTime? @db.Date
  gender    Gender?
  address   String?
  email     String?

  /// Контактный телефон в E.164. При регистрации совпадает с `Account.phone`.
  phone       String   @unique
  /// Дополнительные телефоны (ТЗ 5.3).
  extraPhones String[] @default([])

  telegram String?
  photoUrl String?
  notes    String?

  /// Филиал, в котором учится студент (ТЗ 3.3, форма из ТЗ 5.3). Необязателен:
  /// профиль заводится раньше, чем становится известен филиал.
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status StudentStatus @default(ACTIVE)

  /// Сотрудник, которым стал этот студент (ТЗ 3.1: выпускник → ментор).
  /// Профиль студента при переводе не удаляется и не копируется — учебная
  /// история остаётся здесь, а связь позволяет её найти со стороны сотрудника.
  promotedEmployee Employee? @relation("StudentPromotion")

  /// Группы студента — действующие и закрытые (ТЗ 5.5, кабинет из ТЗ 5.3).
  /// Одновременно активным может быть одно членство на курс (решение сессии 0012):
  /// учиться на Frontend и English параллельно можно, в двух группах одного
  /// курса — нет.
  groups GroupStudent[]

  /// Заметки сотрудников о студенте (ТЗ 5.3: карточка — Feedback).
  feedback Feedback[]

  /// Родители и опекуны (ТЗ 4). Телефон родителя раньше лежал колонкой
  /// `parentPhone` — с появлением `Parent` она стала бы вторым источником
  /// истины о том же контакте, поэтому убрана миграцией с переносом данных.
  parents StudentParent[]

  /// Отметки в журнале (ТЗ 5.8). Ссылка идёт на профиль, а не на членство
  /// в группе: исключение из состава не должно стирать проставленные баллы.
  journalEntries JournalEntry[]

  /// Итоги недель — из их среднего выводится общий балл студента (ТЗ 5.8).
  weekResults WeekResult[]

  /// Коины (ТЗ 5.9): баланс и история начислений.
  coinBalance      CoinBalance?
  coinTransactions CoinTransaction[]

  /// Победы в месячном рейтинге (ТЗ 5.13: «Winners of the last month»).
  monthlyWins MonthlyWinner[]

  /// Выпуски (ТЗ 5.11). Их может быть несколько: закончив один курс, человек
  /// идёт на следующий и выпускается снова.
  graduations Graduate[]

  /// Помесячные начисления за обучение (ТЗ 5.16). `RESTRICT` с их стороны:
  /// удаление профиля унесло бы историю оплат, по которой сходится касса.
  payments StudentPayment[]

  /// Полученные от студента деньги — платежи по месяцам и предоплаты (ТЗ 5.16).
  paymentTransactions PaymentTransaction[]

  /// Лид, из которого этот профиль завёлся (ТЗ 5.7: «Transfer в студенты»).
  /// Связь 1:1 и живёт на стороне лида: вопрос «откуда пришёл этот студент»
  /// задаётся редко, а «во что превратилось это обращение» — в каждом отчёте
  /// по воронке. Тот же ход, что с `Employee.formerStudentId` (0004).
  leadOrigin Lead?

  /// Отправленные студенту сообщения (ТЗ 5.19). `SET NULL` с их стороны:
  /// удаление профиля не должно стирать историю доставки, а имя и адрес
  /// в ней хранятся снимком и переживают ссылку.
  notifications Notification[]

  /// Договоры студента (ТЗ 5.3).
  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@index([branchId])
  @@map("students")
}

/// Профиль сотрудника (ТЗ 5.14).
model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String?  @unique @db.Uuid
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  firstName  String
  lastName   String
  middleName String?
  birthDate  DateTime? @db.Date
  gender     Gender?
  address    String?
  email      String?

  /// Контактный телефон в E.164.
  phone String @unique

  telegram    String?
  photoUrl    String?
  description String?
  /// Опыт работы — свободный текст формы «Experience» (ТЗ 5.14).
  experience  String?

  /// Филиал сотрудника (ТЗ 3.3, форма из ТЗ 5.14).
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status  EmployeeStatus @default(ACTIVE)
  hiredAt DateTime?      @db.Date

  /// Студент, из которого вырос этот сотрудник (ТЗ 3.1). Заполняется переводом
  /// Студент → Сотрудник; уникален, потому что один профиль студента
  /// переводится ровно один раз.
  formerStudentId String?  @unique @db.Uuid
  formerStudent   Student? @relation("StudentPromotion", fields: [formerStudentId], references: [id], onDelete: SetNull)

  /// Позиции сотрудника (ТЗ 5.14: Position — мультивыбор). Права сотрудника —
  /// объединение прав всех этих позиций (ТЗ 3.2).
  positions EmployeePosition[]

  /// Группы, где сотрудник ведёт занятия или помогает (ТЗ 5.5).
  /// Отсюда же строится раздел «Groups» в профиле ментора (ТЗ 5.4).
  mentorGroups GroupMentor[]

  /// Занятия, которые сотрудник ведёт лично (ТЗ 5.10: ментор в расписании).
  /// Отсюда же берутся часы для расчёта зарплаты (ТЗ 5.16).
  mentorSlots ScheduleSlot[]

  /// Заметки, написанные этим сотрудником о студентах (ТЗ 5.3).
  authoredFeedback Feedback[] @relation("FeedbackAuthor")

  /// Недели журнала, финализированные этим сотрудником (ТЗ 5.8).
  submittedWeeks JournalWeek[] @relation("JournalWeekSubmitter")

  /// Коины, начисленные этим сотрудником вручную (ТЗ 5.9).
  awardedCoins CoinTransaction[] @relation("CoinAuthor")

  /// Уровень ментора по месяцам (ТЗ 5.14). Из него в Фазе 9 берётся часовая
  /// ставка **того месяца**, за который начисляется зарплата (ТЗ 5.16).
  mentorLevels MentorLevelHistory[]

  /// Заявки на аванс этого сотрудника (ТЗ 5.14).
  avansRequests AvansRequest[] @relation("AvansEmployee")

  /// Заявки на аванс, заведённые этим сотрудником (в том числе от чужого имени).
  createdAvansRequests AvansRequest[] @relation("AvansAuthor")

  /// Заявки на аванс, рассмотренные этим сотрудником (ТЗ 5.16, Фаза 9).
  reviewedAvansRequests AvansRequest[] @relation("AvansReviewer")

  /// Месяцы, закрытые этим сотрудником (ТЗ 5.13: снимок победителей).
  closedMonthlyWinners MonthlyWinner[] @relation("MonthlyWinnerAuthor")

  /// Уходы студентов, при которых этот сотрудник был ментором группы
  /// (ТЗ 5.12: «ментор на момент ухода»). Снимок — он не меняется от того,
  /// что сотрудника позже сняли с группы.
  leaveMentorships GroupStudent[] @relation("GroupStudentLeaveMentor")

  /// Сертификаты выпускников, выданные этим сотрудником (ТЗ 5.11).
  issuedCertificates Graduate[] @relation("GraduateCertificateIssuer")

  /// Начисления и платежи, заведённые этим сотрудником (ТЗ 5.16), и платежи,
  /// которые он правил. Все связи `SET NULL`: уход сотрудника не повод стирать
  /// строку кассы — она про деньги студента, а не про того, кто её завёл.
  createdCharges      StudentPayment[]     @relation("StudentPaymentAuthor")
  createdTransactions PaymentTransaction[] @relation("PaymentTransactionAuthor")
  editedTransactions  PaymentTransaction[] @relation("PaymentTransactionEditor")

  /// Расходы центра, проведённые этим сотрудником (ТЗ 5.16). `SET NULL`
  /// по той же причине, что и у кассы: расход остаётся расходом и после
  /// того, как заведший его человек ушёл.
  createdExpenses Expense[] @relation("ExpenseAuthor")

  /// Бюджеты, заведённые этим сотрудником (ТЗ 5.16). `SET NULL`: план центра
  /// переживает уход того, кто его составил.
  createdBudgets Budget[] @relation("BudgetAuthor")

  /// Учебные дни, которые этот сотрудник **фактически провёл** (ТЗ 5.16).
  /// Отсюда берутся часы зарплаты — из журнала, а не из расписания (0032).
  taughtDays JournalDay[] @relation("JournalDayMentor")

  /// Расчёты зарплаты этого сотрудника по месяцам (ТЗ 5.16). `CASCADE`:
  /// расчёт — часть кадровой карточки человека, как помесячный уровень (0021)
  /// и заявка на аванс (0022), а профиль и так удаляется только «чистым».
  salaries Salary[] @relation("SalaryEmployee")

  /// Расчёты и выплаты, заведённые и подтверждённые этим сотрудником (ТЗ 5.16).
  /// Все `SET NULL`: зарплата остаётся выплаченной и после ухода бухгалтера.
  createdSalaries           Salary[]            @relation("SalaryAuthor")
  confirmedSalaries         Salary[]            @relation("SalaryConfirmer")
  createdSalaryTransactions SalaryTransaction[] @relation("SalaryTransactionAuthor")

  /// Финансовые периоды-отчёты, заведённые и закрытые этим сотрудником
  /// (ТЗ 5.16). `SET NULL`: сданный отчёт переживает уход бухгалтера,
  /// который его закрыл.
  createdAccountingPeriods AccountingPeriod[] @relation("AccountingPeriodAuthor")
  closedAccountingPeriods  AccountingPeriod[] @relation("AccountingPeriodCloser")

  /// Шаблоны и рассылки, заведённые и отправленные этим сотрудником (ТЗ 5.19).
  /// Все `SET NULL`: история рассылок — запись о том, что центр написал людям,
  /// и уход автора её не отменяет (тот же довод, что у кассы, 0029–0033).
  createdSmsTemplates SmsTemplate[] @relation("SmsTemplateAuthor")
  createdMailings     Mailing[]     @relation("MailingAuthor")
  sentMailings        Mailing[]     @relation("MailingSender")

  /// Отправленные сотруднику сообщения (ТЗ 5.19: аудитория «Mentors»).
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lastName, firstName])
  @@index([branchId])
  @@map("employees")
}

/// Серверная refresh-сессия (ТЗ 3.1): одна строка — одно устройство.
/// При ротации строка переиспользуется: в неё кладётся хеш нового refresh-токена,
/// поэтому старый токен автоматически перестаёт подходить.
model Session {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// SHA-256 (hex) от выданного refresh-токена. Сам токен не хранится.
  refreshTokenHash String

  userAgent String?
  ip        String?

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([accountId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Одноразовый код сброса пароля по email (ТЗ 3.1, 5.1): 6 цифр, ~10 минут,
/// не более 3 запросов в час и 3 попыток ввода на код.
///
/// Хранится HMAC-SHA256 с серверным секретом, а не сам код: пространство из 10^6
/// значений восстанавливается из обычного хеша мгновенно, если утечёт дамп БД,
/// а ключа HMAC в дампе нет (см. `ResetCodeService`).
model PasswordResetCode {
  id        String  @id @default(uuid()) @db.Uuid
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  codeHash String

  /// Сколько раз код вводили неверно. На пределе код гасится досрочно.
  attempts Int @default(0)

  expiresAt  DateTime
  /// Проставляется при успешном сбросе или при досрочном гашении кода.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Поиск живого кода аккаунта и подсчёт запросов за час.
  @@index([accountId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

// ────────────────────────── Роли, позиции и права (RBAC) ─────────────────────────

/// Право из каталога (ТЗ 3.2), нотация `Permission.<Раздел>.<Действие>`.
///
/// Набор кодов — источник истины в **коде** (`src/rbac/permission-catalog.ts`),
/// а таблица хранит состояние переключателя и описание (ТЗ 5.15: «Permission — каталог
/// прав (toggle)»). Иначе опечатка в `@RequirePermission(...)` молча означала бы
/// право, которого нет ни у кого, — и эндпоинт стал бы недоступен вообще никому.
/// Строки приводятся к каталогу при старте приложения (`PermissionCatalogSyncService`).
model Permission {
  id String @id @default(uuid()) @db.Uuid

  /// Полный код целиком (`Permission.Students.Views`), чтобы строка в БД
  /// и строка в декораторе совпадали побайтово.
  code    String @unique
  section String
  action  String

  description String?

  /// Выключенное право не действует ни для одной позиции (toggle из ТЗ 5.15).
  isEnabled Boolean @default(true)

  /// Служебное право выключить нельзя: сняв управление каталогом прав,
  /// систему нельзя было бы починить через API.
  isSystem Boolean @default(false)

  positions PositionPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
  @@map("permissions")
}

/// Позиция сотрудника (ТЗ 5.14), она же роль доступа из Administration → Users (ТЗ 5.15).
/// Термины «Role» и «Position» в ТЗ разведены, но сущность одна: права выдаются
/// только позициями (ТЗ 3.2), а вторая таблица создала бы второй источник прав.
model Position {
  id String @id @default(uuid()) @db.Uuid

  name        String  @unique
  description String?

  /// Системную позицию нельзя удалить или переименовать: на `Director`
  /// опирается правило доступа к разделу Accounting (ТЗ 3.2).
  isSystem Boolean @default(false)

  permissions PositionPermission[]
  employees   EmployeePosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("positions")
}

/// Права позиции — те самые «галочки» из каталога (ТЗ 3.2).
model PositionPermission {
  positionId   String @db.Uuid
  permissionId String @db.Uuid

  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([positionId, permissionId])
  /// Обратный обход: кто выдаёт это право (нужен при выключении права в каталоге).
  @@index([permissionId])
  @@map("position_permissions")
}

/// Назначение позиции сотруднику (ТЗ 5.14 — мультивыбор, ТЗ 5.15 — drawer «Add roles»).
model EmployeePosition {
  employeeId String @db.Uuid
  positionId String @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, positionId])
  /// Обратный обход: кто занимает позицию (список сотрудников позиции).
  @@index([positionId])
  @@map("employee_positions")
}

// ─────────────────────── Учебный контур: справочники (Фаза 3) ────────────────────

/// Состояние записи справочника. Выключенную запись не предлагают в новых
/// операциях, но она остаётся в истории — поэтому именно статус, а не удаление
/// (ТЗ 5.17: «статус» на карточке филиала).
///
/// Один enum на филиалы, аудитории и курсы: смысл у всех трёх один и тот же,
/// а три одинаковых перечисления пришлось бы держать в согласии руками.
enum DirectoryStatus {
  ACTIVE
  INACTIVE
}

/// Единица длительности курса (ТЗ 5.6 «Duration»; ТЗ 5.5 — «длительность: число + тип»).
/// Тот же тип понадобится группам, поэтому он общий, а не встроен в курс.
enum DurationUnit {
  DAY
  WEEK
  MONTH
}

/// Филиал центра (ТЗ 5.17). Мультифилиальность сквозная (ТЗ 3.3): к филиалу
/// привязаны аудитории, студенты и сотрудники, а позже — группы.
model Branch {
  id String @id @default(uuid()) @db.Uuid

  /// Название филиала (Sadbarg, Profsous…). Уникально: по нему филиал узнают на экранах.
  name String @unique

  city     String
  /// Район города — отдельным полем, потому что карточка филиала показывает его
  /// рядом с городом (ТЗ 5.17), а не внутри строки адреса.
  district String?
  address  String

  /// Телефон филиала в E.164. Не уникален: несколько филиалов могут делить один номер.
  phone String?

  description String?
  status      DirectoryStatus @default(ACTIVE)

  rooms     Room[]
  students  Student[]
  employees Employee[]
  groups    Group[]

  /// Лиды, записанные в этот филиал (ТЗ 3.3: разрез по филиалам сквозной).
  /// Как и остальные ссылки на филиал, стоит `RESTRICT`: филиал с обращениями
  /// не удаляется, иначе исчезло бы, куда человек приходил.
  leads Lead[]

  /// Расходы, отнесённые на этот филиал (ТЗ 5.16). Тоже `RESTRICT`: филиал
  /// с расходами не удаляется, иначе из отчёта молча пропало бы, куда
  /// уходили деньги.
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("branches")
}

/// Аудитория (ТЗ 5.10): источник поля «Room» в расписании занятий.
/// Комната физически принадлежит филиалу, поэтому связь обязательна.
model Room {
  id String @id @default(uuid()) @db.Uuid

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name String

  /// Сколько человек помещается. Понадобится при проверке вместимости группы.
  capacity Int?
  floor    Int?

  description String?
  status      DirectoryStatus @default(ACTIVE)

  /// Занятия, поставленные в этой аудитории (ТЗ 5.10). `RESTRICT` со стороны
  /// слота: аудиторию, занятую в расписании, удалить нельзя (см. `RoomsService`).
  scheduleSlots ScheduleSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Название уникально внутри филиала, а не глобально: аудитория «101»
  /// вполне может быть в каждом филиале.
  @@unique([branchId, name])
  @@index([branchId])
  @@index([status])
  @@map("rooms")
}

/// Курс каталога (ТЗ 5.6). Курсы длятся около месяца, поэтому `fee` —
/// одновременно и помесячное начисление в бухгалтерии (ТЗ 5.16).
model Course {
  id String @id @default(uuid()) @db.Uuid

  title       String  @unique
  subtitle    String?
  description String?

  /// Стоимость курса в сомони (ТЗ 1: валюта TJS). `Decimal`, а не `Float`:
  /// деньги в двоичной плавающей точке накапливают ошибку на сложении.
  fee Decimal @db.Decimal(12, 2)

  /// «Is last course» из ТЗ 5.6: завершение группы такого курса запускает
  /// автовыпуск студентов (ТЗ 5.11).
  isLastCourse Boolean @default(false)

  /// Цвета карточки курса на экранах (Color1/Color2 из ТЗ 5.6), формат `#RRGGBB`.
  colorPrimary   String?
  colorSecondary String?
  logoUrl        String?

  /// Длительность = число + единица (ТЗ 5.6). Хранится парой, а не строкой,
  /// чтобы по ней можно было считать даты окончания групп.
  durationValue Int
  durationUnit  DurationUnit @default(MONTH)

  status DirectoryStatus @default(ACTIVE)

  /// Группы, которые учатся по этому курсу (ТЗ 5.6: «кол-во групп» на карточке).
  groups Group[]

  /// Программа курса (ТЗ 5.6 «Syllabus»). Урок без курса не имеет смысла,
  /// поэтому связь каскадная: удаление курса уносит и его программу.
  lessons SyllabusLesson[]

  /// Лиды, пришедшие на этот курс (ТЗ 5.7). `RESTRICT`, как и группы: курс
  /// с обращениями не удаляется — иначе пропало бы, чем именно интересовались.
  leads Lead[]

  /// Купоны, действующие на этот курс (ТЗ 5.7: «курс(ы)»). Тоже `RESTRICT`:
  /// у купона пустой набор курсов означает «на все курсы», и молчаливое
  /// исчезновение последней строки связки расширило бы скидку вместо того,
  /// чтобы её сузить.
  coupons CouponCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  /// Автовыпуск ищет курсы с флагом последнего — выборка по одному значению.
  @@index([isLastCourse])
  @@map("courses")
}

/// Формат занятий (ТЗ 5.5: Online/Offline).
enum GroupFormat {
  ONLINE
  OFFLINE
}

/// Жизненный цикл группы. ТЗ 5.5 требует поле «статус» и фильтр по нему,
/// но самого перечисления не даёт (в отличие от статусов студента из ТЗ 5.3),
/// поэтому набор выбран решением пользователя (сессия 0008).
enum GroupStatus {
  /// Идёт набор: студентов добирают до вместимости («Required students», ТЗ 5.5).
  RECRUITING
  /// Занятия идут.
  ACTIVE
  /// Срок вышел. Для группы курса с «Is last course» это точка автовыпуска (ТЗ 5.11).
  FINISHED
  /// Группа не состоялась. Отличается от `FINISHED`: обучения не было.
  CANCELLED
}

/// Учебная группа (ТЗ 5.5) — то, к чему сходится весь учебный контур:
/// журнал (ТЗ 5.8), расписание (ТЗ 5.10) и состав студентов ссылаются на неё.
///
/// Курс и филиал обязательны: группа без курса не имеет программы, а без филиала
/// не попадает ни в фильтр «Branch», ни в разрез мультифилиальности (ТЗ 3.3).
/// Обе связи — `RESTRICT`: удаление курса или филиала, за которым числятся
/// группы, отклоняется с объяснением (см. `CoursesService`, `BranchesService`).
model Group {
  id String @id @default(uuid()) @db.Uuid

  name        String
  description String?

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  format GroupFormat @default(OFFLINE)

  /// Сроки обучения. `endDate` можно не передавать: он считается из `startDate`
  /// и длительности — именно ради этого длительность хранится парой «число + единица».
  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date

  /// Длительность группы (ТЗ 5.5: «число + тип»). Может отличаться от длительности
  /// курса: одну и ту же программу растягивают или сжимают под расписание набора.
  durationValue Int?
  durationUnit  DurationUnit @default(MONTH)

  /// «Required students» из ТЗ 5.5 — сколько человек набирают в группу.
  /// Само «набрано/вместимость» посчитается, когда появится состав группы.
  capacity Int?

  status GroupStatus @default(RECRUITING)

  /// Ссылка на групповой чат (ТЗ 5.5: «Telegram-ссылка»).
  telegramUrl String?

  /// Уроки силлабуса, открытые этой группе («Show to group», ТЗ 5.6).
  visibleLessons SyllabusLessonGroup[]

  /// Менторы группы (ТЗ 5.5: «менторы (несколько, роли Teaching/Support)»).
  mentors GroupMentor[]

  /// Расписание группы (ТЗ 5.5: «слоты день+время → Timetable»).
  schedule ScheduleSlot[]

  /// Состав группы (ТЗ 5.5). «Набрано» из «Required students» — это активные
  /// членства, поэтому счётчик в карточке считается с фильтром по статусу.
  students GroupStudent[]

  /// Членства, переведённые **из** этой группы в другие (ТЗ 5.5: Transfer).
  /// Обратная сторона `GroupStudent.transferredFromGroup`; отдельного экрана
  /// у неё нет, но без неё Prisma не назовёт вторую связь на ту же модель.
  transferredStudents GroupStudent[] @relation("GroupStudentTransfer")

  /// Журнал группы — недели с днями, отметками и итогами (ТЗ 5.8).
  journalWeeks JournalWeek[]

  /// Выпускники этой группы (ТЗ 5.11). Заводятся автовыпуском, когда группа
  /// курса с «Is last course» переводится в `FINISHED`.
  graduates Graduate[]

  /// Помесячные начисления за обучение в этой группе (ТЗ 5.16). Единица
  /// начисления — «студент × группа × месяц»: человек может учиться на двух
  /// курсах, и платит он за каждый.
  payments StudentPayment[]

  /// Рассылки, адресованные составу этой группы (ТЗ 5.19: аудитория «Group»).
  mailings Mailing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Название уникально внутри филиала, как у аудиторий: «Frontend-1» набирают
  /// в каждом филиале, а глобальная уникальность заставила бы придумывать
  /// «Sadbarg-Frontend-1». Отдельного `@@index([branchId])` нет намеренно —
  /// фильтр по филиалу обслуживается крайним левым столбцом этого же индекса.
  @@unique([branchId, name])
  @@index([courseId])
  @@index([status])
  /// Под фильтры и отчёты по датам (ТЗ 7).
  @@index([startDate])
  @@map("groups")
}

// ───────────────────── Силлабус курса и материалы (ТЗ 5.6) ────────────────────

/// Тип занятия (ТЗ 5.6: Lecture / Practice / Exam).
///
/// `EXAM` здесь не просто ярлык: в журнале (ТЗ 5.8) на экзаменационном дне
/// приход не начисляется, а балл идёт отдельным слагаемым `Exam`.
enum LessonType {
  LECTURE
  PRACTICE
  EXAM
}

/// Раздел урока, к которому относится материал (ТЗ 5.6: «файлы (Lecture/Practice/Homework)»).
/// Отвечает на вопрос «зачем этот файл», а не «что это за файл».
enum ResourceKind {
  LECTURE
  PRACTICE
  HOMEWORK
}

/// `ResourceFileType` из ТЗ 5.6 — чем является сам материал. Отвечает
/// на вопрос «что это за файл» и нужен экрану, чтобы выбрать иконку
/// и способ открытия (скачать / проиграть / перейти по ссылке).
enum ResourceFileType {
  PDF
  DOC
  SLIDES
  SPREADSHEET
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  /// Внешняя страница, а не файл (например, статья или репозиторий).
  LINK
  OTHER
}

/// Урок программы курса — «Day N» из ТЗ 5.6.
///
/// Номер дня **не уникален** внутри курса намеренно: в один учебный день
/// вполне может стоять и лекция, и практика, а запрет на второй урок с тем же
/// номером был бы придуманным правилом, которое оператору нечем обойти.
/// Поэтому номер — это порядок в списке, а не идентификатор урока.
model SyllabusLesson {
  id String @id @default(uuid()) @db.Uuid

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Номер учебного дня внутри курса («Day 1», «Day 2»…).
  dayNumber Int

  title       String
  description String?

  type   LessonType      @default(LECTURE)
  status DirectoryStatus @default(ACTIVE)

  /// Материалы урока (ТЗ 5.6). Каскад: файл вне урока адресовать нечем.
  files ResourceFile[]

  /// «Show to group» (ТЗ 5.6) — мультивыбор групп, которым урок открыт.
  visibleToGroups SyllabusLessonGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Программа курса всегда читается целиком и в порядке дней — этого индекса
  /// хватает и на выборку, и на сортировку. Отдельных индексов по `status`
  /// и `type` нет: любая выборка уже сужена курсом, внутри курса уроков десятки.
  @@index([courseId, dayNumber])
  @@map("syllabus_lessons")
}

/// «Show to group» (ТЗ 5.6): какой группе показан какой урок.
///
/// Каскад с обеих сторон — это настройка видимости, а не данные: удалённая
/// группа не должна оставлять за собой строки, а восстанавливать «кому был
/// показан урок» удалённой группы незачем.
model SyllabusLessonGroup {
  lessonId String @db.Uuid
  groupId  String @db.Uuid

  lesson SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([lessonId, groupId])
  /// Обратный обход: что открыто этой группе (экран «Material» ментора, ТЗ 5.4).
  @@index([groupId])
  @@map("syllabus_lesson_groups")
}

/// Материал урока (ТЗ 5.6: «Resource: Title/Type/ResourceFileType»).
///
/// Хранится **ссылка** на внешнее хранилище, а не сам файл (решение сессии 0009,
/// как `Course.logoUrl`): приём загрузок — отдельный сквозной кусок
/// инфраструктуры, и модель к нему готова без миграции.
model ResourceFile {
  id String @id @default(uuid()) @db.Uuid

  lessonId String         @db.Uuid
  lesson   SyllabusLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title String

  /// Зачем файл (Lecture/Practice/Homework) и что это за файл — два разных
  /// вопроса, и ТЗ 5.6 перечисляет их отдельно («Type» и «ResourceFileType»).
  kind     ResourceKind     @default(LECTURE)
  fileType ResourceFileType @default(OTHER)

  url         String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@map("resource_files")
}

// ────────────────────────── Менторы группы (ТЗ 5.5) ──────────────────────────

/// Роль ментора в группе (ТЗ 5.5: «менторы (несколько, роли Teaching/Support)»).
enum GroupMentorRole {
  /// Ведёт занятия. Именно по часам этой роли считается зарплата ментора
  /// («часы по фактически проведённым занятиям × ставка», ТЗ 5.16).
  TEACHING
  /// Помогает на занятиях: разбирает задачи, подхватывает отстающих.
  SUPPORT
}

/// Ментор группы (ТЗ 5.5). У группы их несколько, у каждого своя роль.
///
/// Позиция «Mentor» для назначения **не требуется** (решение сессии 0010):
/// правило пришлось бы опирать на название позиции, а название редактируется
/// администратором (`/positions`), и `Mentor` не помечена `isSystem` — как
/// только позицию переименовали бы, назначение менторов молча сломалось бы.
/// Заодно руководитель, который сам ведёт занятия, не попадает под запрет.
///
/// Каскады с обеих сторон: назначение — это связь, а не самостоятельная запись
/// со своей историей (как `EmployeePosition`). Удалять группу или сотрудника
/// ради сохранения строки о назначении незачем.
model GroupMentor {
  groupId    String @db.Uuid
  employeeId String @db.Uuid

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  role GroupMentorRole @default(TEACHING)

  assignedAt DateTime @default(now())

  /// Один сотрудник в группе ровно один раз: две роли одновременно означали бы,
  /// что часы занятия посчитаны дважды. Роль меняется правкой назначения.
  @@id([groupId, employeeId])
  /// Обратный обход: группы конкретного ментора (раздел «Groups» профиля, ТЗ 5.4).
  @@index([employeeId])
  @@map("group_mentors")
}

// ───────────────────────── Расписание группы (ТЗ 5.5, 5.10) ─────────────────────

/// День недели слота расписания.
///
/// Порядок объявления — это и порядок сортировки типа в PostgreSQL, поэтому
/// неделя читается сверху вниз без отдельного поля порядка. Неделя начинается
/// с понедельника: так её показывают календари в ru/tg-локалях.
enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Слот расписания группы (ТЗ 5.5: «расписание (слоты день+время → Timetable)»).
///
/// Слот **повторяется еженедельно** в пределах сроков группы (решение сессии 0011):
/// «Понедельник 10:00–12:00 в аудитории 101» — одна строка на весь курс, а не
/// по строке на каждое занятие. Календарь Day/Week/Month (ТЗ 5.10) разворачивает
/// слоты в конкретные даты на лету.
///
/// Тип занятия (Lecture/Practice/Exam) слоту не принадлежит намеренно: при
/// еженедельном повторении каждый понедельник — это другой день программы,
/// и тип берётся из силлабуса (`SyllabusLesson.type`), а не из слота.
model ScheduleSlot {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  dayOfWeek WeekDay

  /// Начало и конец занятия — минуты от полуночи (0…1439), а не `time`.
  /// Целое число сравнимо и сортируемо без разбора часовых поясов, а Prisma
  /// отдаёт `@db.Time` как `DateTime` с фиктивной датой — на нём проверка
  /// пересечений читалась бы хуже, чем на числах. Наружу уходит `HH:MM`.
  startMinute Int
  endMinute   Int

  /// Аудитория занятия (ТЗ 5.10). Необязательна: у онлайн-группы её нет.
  /// `RESTRICT`: аудитория — самостоятельная запись справочника, и её удаление
  /// не должно молча стирать занятия из расписания (как филиал и курс).
  roomId String? @db.Uuid
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  /// Кто ведёт это занятие (ТЗ 5.10 показывает ментора в календаре).
  /// Только из числа менторов группы — проверяется сервисом; в БД связь идёт
  /// на сотрудника, а не на `GroupMentor`, потому что `SET NULL` по составному
  /// ключу обнулил бы заодно и `groupId`. При снятии ментора с группы поле
  /// очищается той же транзакцией (`GroupMentorsRepository.delete`).
  mentorId String?   @db.Uuid
  mentor   Employee? @relation(fields: [mentorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Расписание группы читается целиком и в порядке «день недели, время».
  @@index([groupId, dayOfWeek, startMinute])
  /// Поиск пересечений: занята ли аудитория и не ведёт ли ментор другое занятие.
  @@index([roomId, dayOfWeek])
  @@index([mentorId, dayOfWeek])
  @@map("schedule_slots")
}

// ───────────────────────── Состав группы (ТЗ 5.5, 5.12) ─────────────────────────

/// Статус участия студента в группе (ТЗ 5.5: «массовые Change status
/// (с обязательной причиной = Reason)»).
///
/// Это статус **членства**, а не самого студента (`Student.status`, ТЗ 5.3):
/// студент может параллельно учиться на другом курсе, и уход из одной группы
/// не означает, что он ушёл из центра. Решение сессии 0012.
enum GroupStudentStatus {
  /// Учится в группе. Считается в «набрано» из «Required students» (ТЗ 5.5).
  ACTIVE
  /// Покинул курс, не завершив его. Ровно эти записи и есть «Left courses»
  /// из ТЗ 5.12: группа на момент ухода, причина и дата лежат здесь же.
  LEFT
  /// Прошёл обучение в группе до конца (ТЗ 5.3: статус студента Finished).
  FINISHED
  /// Переведён в другую группу (ТЗ 5.5: Transfer). Отдельный статус, а не `LEFT`:
  /// переведённый не покинул центр, и в отчёт по покинувшим он попадать не должен.
  TRANSFERRED
}

/// Студент в составе группы (ТЗ 5.5: «состав студентов»).
///
/// Эта же строка играет роль `Enrollment` из карты сущностей ТЗ 4: заводить
/// вторую таблицу «история зачислений» значило бы держать два источника истины
/// об одном и том же (решение сессии 0012). История сохраняется тем, что
/// закрытые членства (`LEFT`/`FINISHED`/`TRANSFERRED`) не удаляются, а остаются
/// со своей причиной и датой.
///
/// Каскады с обеих сторон — как у `GroupMentor`: членство это связь, а не
/// самостоятельная запись. Удаление группы при этом упирается в проверку
/// сервиса (409), чтобы учебная история не исчезала молча.
model GroupStudent {
  groupId   String @db.Uuid
  studentId String @db.Uuid

  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status GroupStudentStatus @default(ACTIVE)

  /// Причина смены статуса (ТЗ 5.5: Reason обязателен; ТЗ 5.12: «причина —
  /// свободный текст»). У только что зачисленного студента причины нет.
  statusReason    String?
  /// Когда статус меняли в последний раз (ТЗ 5.12: «причина и дата»).
  statusChangedAt DateTime?

  /// Откуда студент переведён сюда (ТЗ 5.5: Transfer). `SET NULL`: удаление
  /// прежней группы не должно уносить действующее членство в новой.
  transferredFromGroupId String? @db.Uuid
  transferredFromGroup   Group?  @relation("GroupStudentTransfer", fields: [transferredFromGroupId], references: [id], onDelete: SetNull)

  /// Ментор группы **на момент ухода** (ТЗ 5.12: «группа/ментор на момент ухода»).
  ///
  /// Это снимок, а не вычисляемое значение: ментора можно было бы выводить
  /// из состава менторов группы, но тогда смена преподавателя в ноябре
  /// переписала бы отчёт за сентябрь — то же соображение, по которому
  /// `MonthlyWinner` сделан таблицей, а не расчётом на лету (сессия 0024).
  ///
  /// Заполняется только при переводе членства в `LEFT` и снимается при любом
  /// другом статусе: у продолжающего учиться «ментора на момент ухода» нет.
  /// `SET NULL` — удаление профиля сотрудника не повод стирать строку ухода:
  /// она про студента.
  mentorAtLeaveId String?   @db.Uuid
  mentorAtLeave   Employee? @relation("GroupStudentLeaveMentor", fields: [mentorAtLeaveId], references: [id], onDelete: SetNull)

  enrolledAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один студент в группе ровно один раз. Вернувшийся в ту же группу занимает
  /// прежнюю строку, а не заводит вторую: «дважды в одной группе» не значит
  /// ничего, а правило «одно активное членство на курс» держит сервис —
  /// частичный уникальный индекс Prisma не выражает.
  @@id([groupId, studentId])
  /// Обратный обход: группы конкретного студента (кабинет студента, ТЗ 5.3).
  @@index([studentId])
  /// Под «набрано/вместимость» и секцию Left course карточки группы (ТЗ 5.5, 5.12).
  @@index([groupId, status])
  /// Витрина покинувших курсы (ТЗ 5.12) читает уходы **по всему центру**
  /// за период: отбор идёт по статусу и дате ухода, а не по группе.
  @@index([status, statusChangedAt])
  @@index([transferredFromGroupId])
  @@index([mentorAtLeaveId])
  @@map("group_students")
}

/// Обратная связь по студенту (ТЗ 5.3: карточка — Feedback / Edit / Block / Delete).
///
/// Заметка сотрудника о студенте: наблюдение ментора, разговор с родителями,
/// причина пропусков. Это не оценка: успеваемость и рейтинг считаются
/// по журналу (ТЗ 5.8), и вторая шкала конкурировала бы с ними.
model Feedback {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Автор заметки. Необязателен: профиль сотрудника может быть удалён (ТЗ 5.14),
  /// но заметка остаётся — она про студента, а не про того, кто её написал.
  authorId String?   @db.Uuid
  author   Employee? @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Заметки читаются лентой по студенту, свежие сверху.
  @@index([studentId, createdAt])
  /// Обратный обход: что писал конкретный сотрудник.
  @@index([authorId])
  @@map("student_feedback")
}

/// Кем родитель приходится студенту (ТЗ 4: Parent/Guardian).
///
/// Необязательно: регистрация (ТЗ 3.1) собирает у студента только номер
/// родителя и «кем» не спрашивает — запись, заведённая ею, знает о человеке
/// ровно телефон. Ставить в такой ситуации `OTHER` значило бы утверждать,
/// что степень родства выяснена и оказалась «прочее».
enum ParentRelation {
  MOTHER
  FATHER
  GUARDIAN
  OTHER
}

/// Родитель или опекун (ТЗ 4: Parent/Guardian).
///
/// Запись **общая**, а не принадлежащая студенту: у одного родителя бывает
/// несколько детей в центре, и вторая копия его контактов разошлась бы
/// с первой на первой же смене номера, а обзвон родителей группы посчитал бы
/// его дважды.
///
/// Узнаётся по телефону: внутреннего идентификатора у оператора нет, а номер
/// он и так вводит — тот же естественный ключ, по которому импорт состава
/// находит студентов (решение сессии 0013).
model Parent {
  id String @id @default(uuid()) @db.Uuid

  /// Имя и фамилия необязательны — см. `ParentRelation`: при регистрации
  /// известен только номер, а требовать ФИО значило бы не дать записать
  /// то, что ТЗ 3.1 собирает.
  firstName String?
  lastName  String?

  /// Телефон в E.164 — естественный ключ записи (ТЗ 3.1).
  phone String @unique

  email    String?
  telegram String?
  notes    String?

  /// Дети этого родителя в центре.
  students StudentParent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

/// Связь «студент ↔ родитель» (ТЗ 4).
///
/// Степень родства живёт здесь, а не в `Parent`: один и тот же человек бывает
/// матерью одному ребёнку и опекуном другому, и в самой записи родителя это
/// поле пришлось бы выбирать между двумя верными значениями.
model StudentParent {
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parentId String @db.Uuid
  parent   Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  relation ParentRelation?

  createdAt DateTime @default(now())

  /// Один родитель у студента ровно один раз — как ментор в группе (сессия 0010).
  @@id([studentId, parentId])
  /// Обратный обход: дети этого родителя.
  @@index([parentId])
  @@map("student_parents")
}

// ───────────────── Журнал, успеваемость и коины (ТЗ 5.8, 5.9) ─────────────────

/// Отметка посещаемости за день (ТЗ 5.8: «Att»).
///
/// `LATE` — отдельная отметка, а не разновидность `PRESENT`: дашборд (ТЗ 5.2)
/// строит график «Attendance (Late/Absent)», и склеив их, различить эти два
/// случая было бы нечем. На баллы опоздание влияет как приход: человек пришёл,
/// а лишать его балла ТЗ 5.8 не просит.
enum AttendanceMark {
  PRESENT
  LATE
  ABSENT
}

/// Откуда взялись коины (ТЗ 5.9).
enum CoinSource {
  /// Ручное начисление сотрудником с обязательной причиной.
  MANUAL
  /// Автоначисление по итогам недели при финализации.
  WEEK_RESULT
}

/// Неделя журнала группы (ТЗ 5.8: «Недели (NEW WEEK)»).
///
/// Дни недели задаёт оператор (решение сессии 0018), а не расписание группы:
/// слоты (`ScheduleSlot`) повторяются еженедельно и описывают план, журнал же
/// фиксирует **факт** — занятие могло не состояться или пройти не по плану.
model JournalWeek {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Порядковый номер недели в группе — «Week 1», «Week 2» на экране.
  /// Назначается системой (`max + 1`), а не оператором: два способа задать
  /// один и тот же порядок разошлись бы на первой же вставке недели в середину.
  weekNumber Int

  /// Начало недели. Учебные дни лежат отдельными строками и обязаны
  /// укладываться в семь суток от этой даты — иначе «неделя» перестала бы
  /// означать что-либо, а `Sum` считался бы по произвольному отрезку.
  startDate DateTime @db.Date

  /// Финализация (ТЗ 5.8: «Отправить результат»): неделя блокируется,
  /// коины начисляются, отчёт уходит Директору. `null` — неделя открыта.
  submittedAt   DateTime?
  submittedById String?   @db.Uuid
  submittedBy   Employee? @relation("JournalWeekSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  days    JournalDay[]
  results WeekResult[]
  /// Коины, начисленные по итогам этой недели (ТЗ 5.9).
  coins   CoinTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, weekNumber])
  /// Журнал группы читается по порядку недель.
  @@index([groupId, startDate])
  @@map("journal_weeks")
}

/// Учебный день внутри недели журнала (ТЗ 5.8: «по дням»).
///
/// Отдельная таблица, а не набор дат в `JournalEntry`: без неё день, в который
/// занятие было, но никого ещё не отметили, не существовал бы, и «отметить
/// всех присутствующими» нечего было бы заполнять.
model JournalDay {
  id String @id @default(uuid()) @db.Uuid

  weekId String      @db.Uuid
  week   JournalWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// Тип занятия (ТЗ 5.6). На `EXAM` приход не начисляется (ТЗ 5.8) — балл
  /// за экзамен идёт отдельным слагаемым `WeekResult.exam`.
  type LessonType @default(LECTURE)

  /// Кто **фактически** провёл это занятие и сколько оно шло — второй множитель
  /// зарплаты из ТЗ 5.16 («часы по фактически проведённым занятиям × часовая
  /// ставка уровня месяца», решение пользователя, сессия 0032).
  ///
  /// Часы живут здесь, а не в расписании, ровно по той причине, по которой
  /// журнал вообще существует отдельно от слотов (0011, 0018): **слот — это
  /// план, а журнал фиксирует факт**. Занятие могло не состояться, пройти
  /// в другой день или с подменяющим ментором, и считать зарплату по плану
  /// значило бы платить за то, чего не было.
  ///
  /// Оба поля необязательны: журнал ведут и там, где зарплату по часам
  /// не считают, а день без ведущего — законное состояние, которое обязано
  /// быть **видимым** (тот же довод, что у месяца без уровня, 0021).
  /// `SET NULL` на сотрудника: увольнение не переписывает прошлое — занятие
  /// состоялось, и запись о нём остаётся.
  mentorId String?   @db.Uuid
  mentor   Employee? @relation("JournalDayMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  /// Длительность занятия в минутах. Минуты, а не часы: в минутах длительность
  /// вводят («полтора часа» — это 90), и целое число не накапливает ошибку
  /// на сложении месяца — тот же довод, что у времени слота (0011) и у тыйинов
  /// в кассе (0029). Часы наружу выводятся делением.
  durationMinutes Int?

  entries JournalEntry[]

  createdAt DateTime @default(now())

  /// Один день в неделе ровно один раз: две строки на одну дату означали бы
  /// два прихода за одно занятие.
  @@unique([weekId, date])
  /// Ведомость месяца (ТЗ 5.16) читает часы ментора отрезком дат — агрегат
  /// ложится на этот индекс.
  @@index([mentorId, date])
  @@map("journal_days")
}

/// Клетка журнала: посещаемость и балл за ДЗ конкретного студента в конкретный
/// день (ТЗ 5.8: «Att + Score»).
model JournalEntry {
  id String @id @default(uuid()) @db.Uuid

  dayId String     @db.Uuid
  day   JournalDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  /// Ссылка на **студента**, а не на членство `GroupStudent` (решение сессии 0018):
  /// исключение из состава (ТЗ 5.5) не должно каскадом стирать уже проставленные
  /// баллы — журнал остаётся полным. Группа известна из недели.
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// `null` — клетка ещё не отмечена. «Не отмечен» и «отсутствовал» — разные
  /// состояния: первое не должно попадать в отчёт по пропускам (ТЗ 5.2).
  attendance AttendanceMark?

  /// Балл за домашнее задание, 0…5 (ТЗ 5.8). `null` — не проверено.
  score Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayId, studentId])
  /// Обратный обход: успеваемость конкретного студента (ТЗ 5.3: Performance).
  @@index([studentId])
  @@map("journal_entries")
}

/// Итог недели по студенту (ТЗ 5.8: «в конце недели Bonus / Exam / Sum»).
model WeekResult {
  weekId String      @db.Uuid
  week   JournalWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Ручные слагаемые недели: премия и балл за экзамен.
  bonus Int @default(0)
  exam  Int @default(0)

  /// Итог недели: `Σ(приходы) + Σ(ДЗ) + Exam + Bonus` (ТЗ 5.8).
  ///
  /// Хранится, а не считается при каждом чтении: общий балл студента — это
  /// среднее `sum` по всем неделям (ТЗ 5.8), и рейтинг центра (ТЗ 5.13)
  /// пришлось бы собирать обходом всех клеток журнала. Пересчитывается той же
  /// транзакцией, что и любое изменение недели, — второго источника истины
  /// не возникает.
  sum Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([weekId, studentId])
  /// Обратный обход: все итоги студента — из них выводится общий балл.
  @@index([studentId])
  @@map("week_results")
}

/// Баланс коинов студента (ТЗ 5.9).
///
/// Списание запрещено, поэтому баланс только растёт и равен сумме начислений.
/// Хранится ради списков и рейтингов: агрегат по истории на каждую строку
/// экрана — это запрос на строку.
model CoinBalance {
  studentId String  @id @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  balance Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("coin_balances")
}

/// Начисление коинов (ТЗ 5.9). Строка истории у студента.
model CoinTransaction {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Всегда положительное: списание коинов запрещено (ТЗ 5.9), поэтому
  /// отрицательных строк в истории не бывает по определению.
  amount Int

  /// Причина обязательна при ручном начислении (ТЗ 5.9); у автоматического
  /// это описание недели, по итогам которой оно прошло.
  reason String

  source CoinSource

  /// Неделя, по итогам которой начислено (`source = WEEK_RESULT`).
  /// `SET NULL`: удаление недели не повод стирать уже выданные коины —
  /// у студента их не отнять.
  weekId String?      @db.Uuid
  week   JournalWeek? @relation(fields: [weekId], references: [id], onDelete: SetNull)

  /// Кто начислил. `null` — автоначисление или удалённый профиль сотрудника.
  authorId String?   @db.Uuid
  author   Employee? @relation("CoinAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Одно автоначисление на студента за неделю. У ручных начислений `weekId`
  /// равен `null`, а NULL-ы в PostgreSQL друг с другом не конфликтуют —
  /// ограничение работает как частичное и ручных начислений не задевает.
  @@unique([weekId, studentId])
  /// История студента читается свежими сверху.
  @@index([studentId, createdAt])
  @@map("coin_transactions")
}

/// Уровень ментора (ТЗ 5.14: «Mentor levels — CRUD-справочник: уровень +
/// **часовая ставка**»). Справочник центра, а не свойство сотрудника: ставку
/// пересматривают для всей лестницы разом, и хранить её у каждого человека
/// значило бы править N строк вместо одной.
///
/// Кому какой уровень назначен — в `MentorLevelHistory`, помесячно.
model MentorLevel {
  id String @id @default(uuid()) @db.Uuid

  /// Название ступени («Junior mentor», «Senior mentor»). Уникально: по нему
  /// уровень узнают на экранах, а тёзка читалась бы как та же запись.
  name String @unique

  description String?

  /// Часовая ставка в сомони (ТЗ 1: валюта TJS). `Decimal`, а не `Float`:
  /// из неё в Фазе 9 считается зарплата «часы × ставка» (ТЗ 5.16), а деньги
  /// в двоичной плавающей точке накапливают ошибку на сложении.
  hourlyRate Decimal @db.Decimal(12, 2)

  /// Тот же `DirectoryStatus`, что у филиалов, аудиторий и курсов: смысл
  /// «выведен из работы, но остаётся в истории» здесь ровно тот же.
  /// Выключенный уровень не проставляют новым месяцам, но уже проставленный
  /// остаётся — иначе прошлые зарплаты потеряли бы ставку.
  status DirectoryStatus @default(ACTIVE)

  /// Месяцы, в которых этот уровень кому-то проставлен. На счётчике держится
  /// запрет удалять уровень, по которому уже считали зарплату.
  history MentorLevelHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("mentor_levels")
}

/// Уровень сотрудника в конкретном месяце (ТЗ 5.14: «история по месяцам →
/// зарплата по уровню месяца»).
///
/// Помесячность здесь не украшение: зарплата считается по ставке уровня **того
/// месяца**, за который начисляется (ТЗ 5.16), и один «текущий уровень» задним
/// числом давал бы неверные суммы за все прошлые месяцы сразу.
model MentorLevelHistory {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  /// `CASCADE`: помесячный уровень — часть кадровой карточки, а не
  /// самостоятельная запись со своим автором. Профиль сотрудника и так
  /// удаляется только «чистым» (ТЗ 5.14, сессия 0020).
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  levelId String      @db.Uuid
  /// `RESTRICT`: уровень, по которому уже считали зарплату, не должен исчезать
  /// из справочника молча — сервис отвечает 409 с числом месяцев. То же
  /// решение, что у филиала с записями (0007) и курса с группами (0008).
  level   MentorLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)

  /// Первое число месяца (`@db.Date`, наружу — `YYYY-MM`). Дата, а не пара
  /// чисел «год + месяц»: сравнение периодов и выборка «уровни за квартал»
  /// (ТЗ 5.16) выражаются обычным диапазоном, а не арифметикой.
  month DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Одна запись на сотрудника в месяц: две строки о ставке одного месяца
  /// заставили бы расчёт зарплаты выбирать между ними, и забытая сортировка
  /// давала бы тихо неверную сумму.
  @@unique([employeeId, month])
  /// «Кому проставлен этот уровень» — обратный обход и счётчик для запрета удаления.
  @@index([levelId])
  /// Зарплатная ведомость месяца читает всех сотрудников сразу (ТЗ 5.16).
  @@index([month])
  @@map("mentor_level_history")
}

/// Состояние заявки на аванс (ТЗ 5.16: «заявка ментора → Approve/Deny»).
enum AvansStatus {
  /// Подана и ждёт рассмотрения бухгалтерией.
  PENDING
  /// Одобрена: по ТЗ 5.16 одобренный аванс становится `Prepaid` в расчёте месяца.
  APPROVED
  /// Отклонена с причиной.
  DENIED
}

/// Заявка сотрудника на аванс (ТЗ 5.14: `GET/POST /employees/{id}/avans`).
///
/// Подача — Фаза 6, рассмотрение — бухгалтерия (`/accounting/avans/{id}/approve|deny`,
/// ТЗ 5.16, Фаза 9). Колонки рассмотрения заведены сразу и необязательны:
/// миграции данных они не требуют, а без них Фазе 9 пришлось бы второй раз
/// трогать ту же таблицу — то же соображение, по которому сессия 0007 завела
/// `Student.branchId` заранее.
model AvansRequest {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  /// `CASCADE`: заявка — часть кадровой карточки человека, а не самостоятельная
  /// запись со своим автором. Профиль сотрудника и так удаляется только
  /// «чистым» (ТЗ 5.14, сессия 0020).
  employee   Employee @relation("AvansEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Запрошенная сумма в сомони (ТЗ 1: валюта TJS). `Decimal`, как часовая
  /// ставка: в Фазе 9 одобренная заявка вычитается из зарплаты месяца
  /// (ТЗ 5.16: «одобренный = Prepaid»), а деньги в двоичной плавающей точке
  /// накапливают ошибку на сложении.
  amount Decimal @db.Decimal(12, 2)

  /// Причина — обязательна: заявку рассматривает другой человек, и без «зачем»
  /// решать ему нечего.
  reason String

  /// Месяц зарплаты, из которой удержится аванс (первое число, `@db.Date`,
  /// наружу — `YYYY-MM`). Тот же формат, что у истории уровней, и по той же
  /// причине: `Prepaid` по ТЗ 5.16 относится к **месяцу**, а не к дате
  /// одобрения, иначе заявка за сентябрь, одобренная 2 октября, легла бы
  /// не в тот расчёт.
  month DateTime @db.Date

  status AvansStatus @default(PENDING)

  /// Кто завёл заявку (из токена). `null` — у аккаунта нет профиля сотрудника
  /// или профиль удалён; сама заявка при этом остаётся: она о том, **кому**
  /// аванс, а не о том, кто нажал кнопку.
  createdById String?   @db.Uuid
  createdBy   Employee? @relation("AvansAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Рассмотрение — Фаза 9. Статус без «кто и когда» не отвечал бы на вопрос,
  /// на каком основании выданы деньги.
  reviewedById  String?   @db.Uuid
  reviewedBy    Employee? @relation("AvansReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  /// Комментарий рассмотревшего (ТЗ 5.16: «Approve/Deny (сумма + причина)»).
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Заявки сотрудника и проверка «нет ли уже нерассмотренной» (одна `PENDING`
  /// на сотрудника — решение сессии 0022).
  @@index([employeeId, status])
  /// Очередь бухгалтерии: что ждёт рассмотрения, свежие сверху (ТЗ 5.16, Фаза 9).
  @@index([status, createdAt])
  /// Зарплатная ведомость месяца читает авансы всех сотрудников сразу (ТЗ 5.16).
  @@index([month])
  @@map("avans_requests")
}

/// Победитель месяца (ТЗ 5.13: «Winners of the last month (снимок месяца)»).
///
/// Единственная таблица успеваемости, которая **хранит** посчитанное. Общий балл
/// (сессия 0019) и категория активности выводятся агрегатом на лету именно
/// затем, чтобы не заводить второй источник истины, — здесь всё наоборот:
/// снимок обязан пережить последующие правки журнала. Без таблицы «победитель
/// июня» пересчитывался бы каждый раз заново, и правка старой недели задним
/// числом молча переписала бы прошлогодних победителей, то есть снимок
/// перестал бы быть снимком.
///
/// Заполняется **осознанным действием** (`POST /leaders/winners`, решение
/// сессии 0024), как финализация недели журнала: фоновых задач BullMQ в проекте
/// нет ни одной работающей до Фазы 11, и вешать на них первую живую логику рано.
model MonthlyWinner {
  id String @id @default(uuid()) @db.Uuid

  /// Месяц снимка (первое число, `@db.Date`, наружу — `YYYY-MM`). Тот же формат
  /// и тот же `parseIsoMonth`, что у истории уровней (0021) и аванса (0022).
  month DateTime @db.Date

  studentId String  @db.Uuid
  /// `RESTRICT`, а не `CASCADE`: удаление профиля молча вынуло бы человека
  /// из закрытого месяца, и снимок изменился бы задним числом — ровно то,
  /// против чего он и существует. Правило «профиль с историей не удаляется»
  /// (0014, дополнено журналом и коинами в 0018) получает ещё одну причину,
  /// и она называется в тексте отказа, а не приходит ошибкой внешнего ключа.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Место в месяце: «сколько строго выше, плюс один». При равенстве баллов
  /// место одно на всех (0019), поэтому номера идут с пропусками: 1, 1, 3.
  place Int

  /// Средний `Sum` по финализированным неделям **этого месяца**, округлённый
  /// до двух знаков — ровно то число, которое было показано. `Decimal`, а не
  /// `Float`: снимок сравнивают с показанным значением, и двоичная плавающая
  /// точка дала бы 87.32999999999998 там, где на экране стояло 87.33.
  averageScore Decimal @db.Decimal(7, 2)

  /// Сколько недель месяца учтено — без этого «100 баллов» за одну неделю
  /// и за четыре выглядели бы одинаково.
  weeksCount Int

  /// Кто закрыл месяц. `SET NULL`, как `submittedById` у недели журнала:
  /// уход сотрудника не повод стирать снимок.
  createdById String?   @db.Uuid
  createdBy   Employee? @relation("MonthlyWinnerAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Один студент в месяце ровно один раз. Здесь «последний рубеж» в БД
  /// действительно есть — как у автоначисления коинов (0018): повторное
  /// закрытие месяца сервис отклоняет 409, а индекс страхует гонку.
  @@unique([month, studentId])
  /// Снимок месяца читается целиком и по местам.
  @@index([month, place])
  /// Обратный обход: победы конкретного студента (и опора для `RESTRICT`).
  @@index([studentId])
  @@map("monthly_winners")
}

/// Статус трудоустройства выпускника (ТЗ 5.11: «#OpenToWork / #Work /
/// #Freelancer / #FurtherEducation / Entrepreneur»).
///
/// Значения по умолчанию нет намеренно: у только что выпустившегося человека
/// статус ещё не выясняли, и `OPEN_TO_WORK` утверждал бы, что выяснили и он
/// ищет работу. Пробел остаётся видимым (`null`) и попадает в счётчики
/// отдельной строкой — то же соображение, что с `unscored` в категориях
/// активности (0019) и «месяцем без записи об уровне» (0021).
enum GraduateEmployment {
  OPEN_TO_WORK
  WORK
  FREELANCER
  FURTHER_EDUCATION
  ENTREPRENEUR
}

/// Выпускник (ТЗ 5.11).
///
/// Заводится **автовыпуском**: когда группа курса с флагом «Is last course»
/// переводится в статус `FINISHED`, все её действующие членства закрываются
/// как `FINISHED`, а на каждого студента заводится строка выпуска (решение
/// пользователя, сессия 0026). Фоновой задачи для этого не требуется — а
/// работающих в проекте нет до Фазы 11 (то же соображение, что у закрытия
/// месяца в 0024 и отчёта Директору в 0018).
///
/// Единица записи — **выпуск с курса**, а не человек: закончив «Frontend»,
/// студент может пойти на «Backend» и выпуститься второй раз. Поэтому ключ
/// естественный — пара «группа + студент», и уникальный индекс делает
/// автовыпуск идемпотентным: повторное сохранение уже завершённой группы
/// не заводит второй строки.
///
/// Вторая таблица `Certificate` из карты сущностей ТЗ 4 **не заводится**:
/// сертификат — это серийный номер и дата выдачи у того же выпуска, а сам PDF
/// генерируется в Фазе 12 по шаблону и нигде не хранится. Отдельная строка 1:1
/// стала бы вторым источником истины о том же (четвёртый раз тот же разбор
/// после `Enrollment` (0012), `Performance` (0019) и `LeftCourse` (0025)).
model Graduate {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  /// `RESTRICT`, как у `MonthlyWinner`: удаление профиля молча стёрло бы факт
  /// выпуска и выданный сертификат. Причину отказа называет сервис
  /// (`DELETE /students/{id}`), а не ошибка внешнего ключа.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  groupId String @db.Uuid
  /// `RESTRICT` по той же причине: группа — это «откуда выпустился», и вместе
  /// с ней исчезли бы курс и филиал выпуска. Группу с составом и так удалить
  /// нельзя (0012), но выпуск держит её и после того, как состав разобрали.
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  /// Дата выпуска. Берётся из `Group.endDate`, если срок группы задан, иначе —
  /// день закрытия: срок группы и есть дата завершения обучения, и вычислять
  /// её вторым способом значило бы разойтись с карточкой группы.
  graduatedAt DateTime @db.Date

  /// «Points» из ТЗ 5.11 — общий балл на момент выпуска. ТЗ 5.8 прямо выводит
  /// его из среднего `Sum` по неделям («…→ рейтинг, корона, категории, Points
  /// выпускника»), поэтому считается он тем же правилом и по тем же
  /// финализированным неделям (0019) — но **замораживается**: сертификат выдан
  /// за конкретное число, и правка старой недели не должна его переписывать.
  /// `Decimal`, а не `Float`: в снимок ложится показанное значение, и двоичная
  /// плавающая точка дала бы 87.32999999999998 там, где стояло 87.33.
  ///
  /// `null` — законное состояние: у студента без единой закрытой недели балла
  /// **нет**, и ноль записал бы его в Black list (правило сессии 0019).
  points Decimal? @db.Decimal(7, 2)

  /// Сколько недель учтено в балле — без этого «100 баллов» за одну неделю
  /// и за двадцать выглядели бы одинаково (как у `MonthlyWinner`).
  weeksCount Int @default(0)

  /// «Level» из ТЗ 5.11 отдельной колонкой **не хранится**: это категория
  /// активности (ТЗ 5.5), и она выводится из `points` чистой функцией
  /// `activityCategoryOf`. Снимком её делает замороженный балл, а не вторая
  /// колонка: пока `points` не меняется, не меняется и уровень. Копия
  /// перечисления категорий в схеме была бы вторым списком порогов, который
  /// разошёлся бы с первым (решение сессии 0019).

  /// Трудоустройство (ТЗ 5.11). Проставляется руками через `PUT /graduates/{id}`:
  /// откуда система узнала бы, где человек работает, не спросив.
  employment GraduateEmployment?
  /// «Work place» из ТЗ 5.11 — свободный текст.
  workPlace  String?

  /// Сертификат (ТЗ 5.11: «Certificate (флаг+PDF)», ТЗ 3.7: «серийный №»).
  /// Флаг отдельным полем не нужен: выдан тот сертификат, у которого есть
  /// серийный номер. Номер уникален по всему центру — два диплома с одним
  /// номером не являются двумя разными документами.
  certificateSerial   String?   @unique
  certificateIssuedAt DateTime? @db.Date

  /// Кто выдал сертификат. `SET NULL`, как `submittedById` у недели журнала:
  /// уход сотрудника не повод стирать факт выдачи.
  certificateIssuedById String?   @db.Uuid
  certificateIssuedBy   Employee? @relation("GraduateCertificateIssuer", fields: [certificateIssuedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Из одной группы студент выпускается ровно один раз. На этом держится
  /// идемпотентность автовыпуска, и «последний рубеж» здесь действительно
  /// в БД — как у автоначисления коинов (0018) и снимка месяца (0024).
  @@unique([groupId, studentId])
  /// Обратный обход: выпуски конкретного студента (и опора для `RESTRICT`).
  @@index([studentId])
  /// Витрина читается за период и по дате выпуска (ТЗ 5.11).
  @@index([graduatedAt])
  /// Счётчики трудоустройства (ТЗ 5.11).
  @@index([employment])
  @@map("graduates")
}

// ──────────────────── Маркетинг: лиды и купоны (ТЗ 5.7) ───────────────────

/// Стадия обращения (ТЗ 5.7): «Lead = пришёл; Client = после бесплатного
/// пробного дня зарегался/заинтересовался».
///
/// Полноценной машины состояний воронки (NEW → TRIAL → CLIENT → LOST) здесь
/// намеренно нет: ТЗ такого перечисления не даёт, а выдуманные статусы стали бы
/// основанием для отчётов Фазы 10 — то есть выдумка попала бы в цифры, по которым
/// оценивают рекламу. ТЗ называет это «типом», и типом это и остаётся.
enum LeadType {
  /// Обращение: позвонил, оставил заявку, пришёл по рекламе.
  LEAD
  /// Побывал на пробном дне и заинтересовался (ТЗ 5.7).
  CLIENT
}

/// Лид / клиент — обращение в центр (ТЗ 5.7).
///
/// Первая точка жизненного цикла из ТЗ 1: «Лид (реклама) → Client (после
/// пробного дня) → Студент → … → Выпускник». Правый конец этой цепочки
/// (`convertedStudentId`) хранится здесь же: перевод в студенты **не удаляет**
/// обращение (решение пользователя, сессия 0027). Иначе на вопросы «сколько
/// лидов сентября стали студентами» и «из какой рекламы пришёл этот студент»
/// (ТЗ 5.2: «статистика лидов») отвечать было бы нечем — воронка теряла бы
/// ровно тот конец, ради которого её и считают.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  firstName String
  lastName  String

  /// Телефон в E.164 (ТЗ 3.1). **Не уникален**, в отличие от `Student.phone`:
  /// один человек может обратиться дважды — осенью по рекламе одного курса,
  /// зимой по рекомендации, — и это два обращения, а не одна запись. Запрет
  /// вычёркивал бы вторую строку из воронки, то есть занижал бы отдачу рекламы.
  /// Замечать повторы — дело оператора: сервис отдаёт подсказку, а не отказ.
  phone String

  email     String?
  birthDate DateTime? @db.Date
  gender    Gender?

  /// Telegram обращения. Формы ТЗ 5.7 в списке полей его не называет, но ТЗ 5.19
  /// делает лидов аудиторией рассылок, а Telegram — основным каналом (ТЗ 3.4):
  /// без этой колонки сочетание «аудитория Leads × канал Telegram» было бы
  /// мертво по построению — рассылка ушла бы в пустоту у каждого получателя.
  telegram String?

  /// «Occupation» из ТЗ 5.7 — род занятий (школьник, студент, работает).
  /// Свободный текст: справочника профессий ТЗ не задаёт, а выдуманный
  /// пришлось бы вести отдельным экраном.
  occupation String?

  /// «Месяц записи» из ТЗ 5.7 — на какой месяц человек хочет записаться.
  /// Первое число месяца (`@db.Date`, наружу `YYYY-MM`) — тот же формат
  /// и тот же `parseIsoMonth`, что у истории уровней (0021), аванса (0022)
  /// и отчёта по оттоку (0025).
  enrollMonth DateTime? @db.Date

  /// Интересующий курс (ТЗ 5.7). `RESTRICT`: курс с обращениями не удаляется —
  /// иначе исчезло бы, чем именно интересовались, а вместе с этим и смысл
  /// отчёта «какая реклама какой курс приводит».
  courseId String? @db.Uuid
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// «Время урока» из ТЗ 5.7 — желаемое время занятий, минуты от полуночи.
  /// Хранится числом, а наружу уходит `HH:MM`: ровно как у слота расписания
  /// (0011), где `@db.Time` был отвергнут из-за разбора часовых поясов там,
  /// где времени суток вообще нет.
  lessonTimeMinute Int?

  notes String?

  /// «Referral source» из ТЗ 5.7 — как человек узнал о центре или кто его
  /// порекомендовал. Свободный текст, по нему же группируется отчёт Фазы 10.
  source String?

  /// UTM-метки рекламной ссылки (ТЗ 5.7). Три отдельные колонки, а не одна
  /// строка: метки приходят из ссылки уже разобранными, и склеивать их, чтобы
  /// потом разбирать обратно, значило бы потерять возможность сгруппировать
  /// отчёт по кампании.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Применённый купон (ТЗ 5.7). Применение купона **к оплате** отложено
  /// из v1 (ТЗ §6), поэтому здесь он только помечает, с какой скидкой человека
  /// приглашали. `RESTRICT`: купон, который кому-то обещали, не удаляется.
  couponId String? @db.Uuid
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)

  /// Филиал, в который записывается (ТЗ 3.3). Необязателен: по рекламе звонят
  /// раньше, чем выбирают филиал.
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  type LeadType @default(LEAD)

  /// Когда обращение стало клиентом (ТЗ 5.7: «после бесплатного пробного дня»).
  /// Проставляется системой при смене типа, а не оператором: дата события,
  /// введённая руками, разошлась бы с самим событием. Обратный перевод
  /// в `LEAD` её снимает — иначе в данных осталась бы дата перехода,
  /// которого нет.
  becameClientAt DateTime?

  /// Профиль студента, в который переведён лид (ТЗ 5.7: «Transfer в студенты»).
  /// Уникален: одно обращение даёт одного студента, повторный перевод — 409.
  ///
  /// `RESTRICT`, как у `MonthlyWinner` (0024) и `Graduate` (0026): удаление
  /// профиля молча превратило бы переведённое обращение в непереведённое,
  /// и воронка изменилась бы задним числом. Выход из положения прямой —
  /// удалить сам лид, тогда профиль освобождается.
  convertedStudentId String?  @unique @db.Uuid
  convertedStudent   Student? @relation(fields: [convertedStudentId], references: [id], onDelete: Restrict)

  /// Когда переведён. Отдельного флага «переведён» нет: переведён тот, у кого
  /// есть ссылка на профиль, — то же решение, что с сертификатом выпускника
  /// (0026), где флаг и номер могли бы разойтись.
  convertedAt DateTime?

  /// Отправленные обращению сообщения (ТЗ 5.19: аудитория «Leads»).
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Поиск по номеру и подсказка «такое обращение уже было».
  @@index([phone])
  /// Список читается свежими сверху и в разрезе стадии (ТЗ 5.7).
  @@index([type, createdAt])
  /// Отчёт по месяцу записи (ТЗ 5.2) и фильтр списка.
  @@index([enrollMonth])
  /// Фильтры списка и опора под `RESTRICT` соответствующих справочников.
  @@index([courseId])
  @@index([branchId])
  @@index([couponId])
  @@map("leads")
}

/// Купон — скидка на курс(ы) (ТЗ 5.7).
///
/// В v1 это **справочник**: применение купона к оплате отложено (ТЗ §6),
/// поэтому купон нигде не уменьшает сумму — он выбирается в карточке лида
/// и печатается в рекламе. Из-за этого у него нет ни счётчика применений,
/// ни правил погашения: и то и другое было бы выдумкой про механику,
/// которую ещё не решили.
model Coupon {
  id String @id @default(uuid()) @db.Uuid

  /// Название или код («OSEN-2026»). Уникально без учёта регистра — проверку
  /// делает сервис, как у филиалов (0007) и позиций (0006): по нему купон
  /// узнают на экранах и называют в рекламе.
  name String @unique

  description String?

  /// Сумма скидки в сомони (ТЗ 1: валюта TJS; ТЗ 5.7: «сумма (сомони)»).
  /// `Decimal`, а не `Float`, — как стоимость курса и часовая ставка.
  ///
  /// Это именно сумма, а не процент: ТЗ называет сомони, и вторая форма скидки
  /// потребовала бы поля «чем является это число», которого ТЗ не задаёт.
  amount Decimal @db.Decimal(12, 2)

  /// Период действия (ТЗ 5.7). Обе границы необязательны и включающие:
  /// бессрочная акция — законное состояние, и подставлять ей выдуманный конец
  /// значило бы погасить её в неизвестный день.
  ///
  /// «Истёк» отдельной колонкой не хранится: это сравнение `validTo`
  /// с сегодняшним днём, и вторая копия того же факта разошлась бы с датами
  /// в первый же день (то же соображение, что с флагом сертификата, 0026).
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date

  /// Active/Inactive из ТЗ 5.7 — общий `DirectoryStatus` (0007): «выведено
  /// из работы, но остаётся в истории». Отличается от периода: акцию можно
  /// выключить раньше срока, не переписывая её даты.
  status DirectoryStatus @default(ACTIVE)

  /// Курсы, на которые действует купон (ТЗ 5.7: «курс(ы)»). **Пустой набор
  /// означает «на все курсы»**: купон без единого курса — это скидка центра,
  /// а не сломанная запись, и заставлять оператора перечислять весь каталог
  /// ради общей акции было бы работой без смысла.
  courses CouponCourse[]

  /// Лиды, которым купон обещан. Держат купон от удаления (`RESTRICT`).
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  /// Выборка действующих на дату — обе границы периода.
  @@index([validFrom, validTo])
  @@map("coupons")
}

/// Связка «купон ↔ курс» (мультивыбор «курс(ы)» из ТЗ 5.7).
///
/// `CASCADE` на купон и `RESTRICT` на курс — разные ответы на разные вопросы,
/// как у слота расписания с аудиторией и ментором (0011): набор курсов это
/// часть самого купона и вне его ничего не значит, а курс — самостоятельная
/// запись справочника, чьё исчезновение молча расширило бы скидку до «всех
/// курсов» (см. правило пустого набора выше).
model CouponCourse {
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  courseId String @db.Uuid
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  /// Один курс в купоне ровно один раз — как ментор в группе (0010)
  /// и родитель у студента (0016).
  @@id([couponId, courseId])
  /// Обратный обход «какие купоны действуют на этот курс» и опора под `RESTRICT`.
  @@index([courseId])
  @@map("coupon_courses")
}

// ──────────────────── Бухгалтерия: платёжный контур (ТЗ 5.16) ────────────────

/// Способ оплаты (ТЗ 5.16: «тип Cash/Alif», в карте сущностей ТЗ 4 —
/// `PaymentType`).
///
/// Справочник, а не перечисление в схеме (решение пользователя, сессия 0029):
/// набор способов оплаты — дело центра, а не разработчика, и появление
/// нового банка не должно требовать миграции и релиза. Тот же шаблон, что
/// у филиалов (0007), аудиторий (0007) и ступеней ментора (0021), включая
/// `DirectoryStatus`: способ выводят из работы, а не удаляют, — иначе прошлые
/// платежи остались бы без названия.
model PaymentType {
  id String @id @default(uuid()) @db.Uuid

  /// Название («Наличные», «Alif», «Перевод»). Уникально без учёта регистра —
  /// проверку делает сервис, как у купонов (0027) и филиалов (0007).
  name        String  @unique
  description String?

  status DirectoryStatus @default(ACTIVE)

  /// Платежи этим способом. `RESTRICT` с их стороны: способ, которым уже
  /// платили, не удаляется — иначе в кассе появились бы платежи «ничем».
  transactions PaymentTransaction[]

  /// Выплаты зарплаты этим же способом (ТЗ 5.16). Справочник **общий** для
  /// прихода и расхода: «Наличные» — это один и тот же способ, и второй
  /// справочник с теми же строками расходился бы с первым (0032).
  salaryTransactions SalaryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payment_types")
}

/// Помесячное начисление студенту (ТЗ 5.16: «помесячное начисление = Fee курса;
/// Not paid = неоплаченный месяц; статус помесячный»).
///
/// Единица — **месяц обучения в конкретной группе**: студент может учиться
/// на двух курсах (решение 0012), и платит он за каждый отдельно. Отсюда
/// естественный ключ «студент + группа + месяц» и уникальный индекс на нём:
/// он же делает начисление месяца идемпотентным — повторный запуск не заводит
/// вторую строку, как повторное сохранение завершённой группы не выдаёт
/// второго диплома (0026).
///
/// Строки заводит **осознанное действие** «начислить месяц» (решение
/// пользователя, сессия 0029), а не фоновая задача: работающих в проекте нет
/// до Фазы 11 — то же соображение, что у финализации недели (0018), закрытия
/// месяца (0024) и автовыпуска (0026).
///
/// `amount` — **снимок** стоимости курса на момент начисления: правка Fee
/// в каталоге не должна переписывать сумму, которую студенту уже назвали.
/// Четвёртый снимок в проекте после `MonthlyWinner` (0024), `mentorAtLeaveId`
/// (0025) и `Graduate.points` (0026).
model StudentPayment {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  /// `RESTRICT`, а не `CASCADE`: удаление профиля молча стёрло бы историю
  /// оплат, по которой сходится касса. Правило «профиль с историей
  /// не удаляется» (0014) получает ещё одну причину, и она называется
  /// в тексте отказа, а не приходит ошибкой внешнего ключа.
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Restrict)

  /// Месяц начисления (первое число, `@db.Date`, наружу — `YYYY-MM`). Тот же
  /// формат и тот же `parseIsoMonth`, что у истории уровней (0021), аванса
  /// (0022), отчёта по оттоку (0025) и месяца записи лида (0027).
  month DateTime @db.Date

  /// Снимок Fee курса в сомони. `Decimal`, а не `Float`: деньги в двоичной
  /// плавающей точке накапливают ошибку на сложении, а из этих строк
  /// складывается выручка центра.
  amount Decimal @db.Decimal(12, 2)

  /// Скидка на месяц в сомони (ТЗ 5.16: «скидки»). К оплате идёт
  /// `amount − discount`; ноль — обычное состояние.
  discount Decimal @default(0) @db.Decimal(12, 2)

  /// Почему дана скидка. Обязательна при ненулевой скидке — как Reason у смены
  /// статуса состава (0012): скидка без объяснения через полгода неотличима
  /// от ошибки оператора.
  discountReason String?

  /// Сколько по месяцу уже принято и сколько осталось (`amount − discount −
  /// paidAmount`, не ниже нуля).
  ///
  /// Осознанная денормализация — тот же случай, что `WeekResult.sum` (0018),
  /// и по той же причине: из этих двух чисел выводится **статус месяца**
  /// («Not paid» из ТЗ 5.16) и долг студента, а по ним отбирают и сортируют
  /// целые экраны. Без хранимых значений каждый список оплат означал бы обход
  /// всех платежей всех месяцев страницы, а витрина должников — обход кассы
  /// центра целиком.
  ///
  /// Второго источника истины при этом не возникает: оба поля **пересчитываются
  /// той же транзакцией**, что и любой платёж (создание, правка, отмена)
  /// и любая правка скидки, причём пересчёт — это `SUM` по платежам месяца,
  /// а не приращение. Карточка начисления вдобавок считает те же числа
  /// по своему списку платежей, поэтому расхождение было бы видно сразу.
  paidAmount      Decimal @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal @default(0) @db.Decimal(12, 2)

  note String?

  /// Кто завёл начисление. `SET NULL`, как `submittedById` у недели журнала.
  createdById String?   @db.Uuid
  createdBy   Employee? @relation("StudentPaymentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Платежи, закрывающие этот месяц. `RESTRICT` с их стороны: начисление
  /// с деньгами не удаляется, иначе платёж повис бы без месяца.
  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Одно начисление на студента, группу и месяц. «Последний рубеж» здесь
  /// действительно в БД — как у автоначисления коинов (0018) и снимка месяца
  /// (0024): повторное начисление сервис пропускает молча, а индекс страхует
  /// гонку двух одновременных запусков.
  @@unique([studentId, groupId, month])
  /// Ведомость месяца по всему центру (ТЗ 5.16) и обзор за период.
  @@index([month])
  /// Оплаты одной группы за месяц — экран «Students payment по группам».
  @@index([groupId, month])
  /// Обратный обход: начисления студента (и опора для `RESTRICT`).
  @@index([studentId])
  /// Витрина должников (ТЗ 5.16) отбирает незакрытые месяцы по всему центру:
  /// `remainingAmount > 0` — её единственное условие.
  @@index([remainingAmount])
  @@map("student_payments")
}

/// Полученные от студента деньги (ТЗ 5.16: «Payment's» — сумма, тип, дата, чек).
///
/// Платёж **всегда** принадлежит студенту и **необязательно** — месяцу:
/// строка без `chargeId` это **предоплата** (ТЗ 5.16: «Prepayment для
/// текущего/нового студента»), то есть деньги, принятые до того, как месяц
/// начислен. Отдельной модели предоплате не заводится: это тот же платёж
/// в состоянии «ещё не разнесён», и вторая таблица разошлась бы с первой
/// в сумме кассы.
///
/// Правка идёт **с причиной** (ТЗ 5.16) и хранит только последнюю: лента
/// изменений — это `AuditLog` Фазы 13, а не вторая строка о том же платеже
/// (тот же довод, что у истории уровней ментора, 0021).
model PaymentTransaction {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// Месяц, который закрывает платёж. `null` — предоплата: деньги на счету
  /// студента, ещё не разнесённые по месяцам. Колонка `studentId` при этом
  /// заполнена всегда — иначе предоплату было бы не к кому отнести.
  chargeId String?         @db.Uuid
  charge   StudentPayment? @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  /// Полученная сумма в сомони. Больше остатка месяца платёж быть не может
  /// (проверка сервиса): переплата — это предоплата, а не «месяц, оплаченный
  /// дважды». Из этого правила следует, что долг студента складывается
  /// из остатков месяцев без вычитаний в обе стороны.
  amount Decimal @db.Decimal(12, 2)

  /// День получения денег (`@db.Date`, наружу — `YYYY-MM-DD`). Отличается
  /// от месяца начисления: сентябрь оплачивают и в августе, и в октябре.
  paidAt DateTime @db.Date

  /// Способ оплаты (ТЗ 5.16). Необязателен: перенесённые остатки и коррекции
  /// способа не имеют, а выдуманный «прочее» утверждал бы, что его выясняли.
  typeId String?      @db.Uuid
  type   PaymentType? @relation(fields: [typeId], references: [id], onDelete: Restrict)

  comment String?

  /// Последняя правка «с причиной» (ТЗ 5.16). Три колонки заполняются вместе
  /// и пусты у неправленого платежа.
  editReason String?
  editedAt   DateTime?
  editedById String?   @db.Uuid
  editedBy   Employee? @relation("PaymentTransactionEditor", fields: [editedById], references: [id], onDelete: SetNull)

  createdById String?   @db.Uuid
  createdBy   Employee? @relation("PaymentTransactionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Касса студента: платежи и предоплаты по дате.
  @@index([studentId, paidAt])
  /// Сколько оплачено по месяцу — считается по этому индексу.
  @@index([chargeId])
  /// Выручка за период (ТЗ 5.16: Income) — отбор по дню получения денег.
  @@index([paidAt])
  /// Обратный обход и опора под `RESTRICT` на способ оплаты.
  @@index([typeId])
  @@map("payment_transactions")
}

/// Категория расхода (ТЗ 5.16: «Expenses: категории — Tax→Income tax/VAT/
/// Property/Social, Office, Marketing, Employees», в карте сущностей ТЗ 4 —
/// `ExpenseCategory`).
///
/// **Двухуровневый справочник** (решение пользователя, сессия 0030): перечень
/// ТЗ сам задан с вложенностью — «Tax» это не расход, а свод четырёх налогов.
/// Плоский список потребовал бы соглашения об именах («Tax: VAT»), чтобы
/// ответить на вопрос «сколько всего ушло на налоги», а перечисление в схеме
/// требовало бы миграции на каждую новую статью — тот же довод, что
/// у филиалов (0007), ступеней ментора (0021) и способов оплаты (0029).
///
/// Глубина ограничена **двумя** уровнями (проверка сервиса): дерево
/// произвольной глубины пришлось бы обходить рекурсивно в каждом отчёте,
/// а ТЗ третьего уровня не знает. Категории из ТЗ заводит миграция —
/// это обычные строки, а не системные: центр вправе их переименовать
/// и завести свои.
model ExpenseCategory {
  id String @id @default(uuid()) @db.Uuid

  /// Название («Налоги», «НДС», «Маркетинг»). Уникально без учёта регистра —
  /// проверку делает сервис, как во всех справочниках проекта.
  name        String  @unique
  description String?

  /// Родительская категория. `null` — категория верхнего уровня.
  /// `RESTRICT`: родителя с подкатегориями не удаляют, иначе они осиротели бы
  /// молча, а вместе с ними и свод по разделу.
  parentId String?           @db.Uuid
  parent   ExpenseCategory?  @relation("ExpenseCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ExpenseCategory[] @relation("ExpenseCategoryTree")

  status DirectoryStatus @default(ACTIVE)

  /// Расходы этой категории. `RESTRICT` с их стороны: категорию, по которой
  /// уже проводили деньги, не удаляют — её выводят из работы (`INACTIVE`).
  expenses Expense[]

  /// Строки бюджетов, планирующих эту статью (ТЗ 5.16). Тоже `RESTRICT`:
  /// исчезнувшая статья оставила бы план без предмета, и «сколько мы решили
  /// потратить на маркетинг» перестало бы иметь ответ.
  budgetLines BudgetCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
  @@map("expense_categories")
}

/// Расход центра (ТЗ 5.16: «Expenses»).
///
/// В карте сущностей ТЗ 4 стоит обобщённый `Transaction` — «любая денежная
/// операция». Он **не заводится**: приход у центра уже описан
/// `PaymentTransaction` (деньги от студента), и общая таблица на два потока
/// потребовала бы колонки-дискриминатора, необязательного `studentId`
/// и необязательной категории — то есть строки, половина полей которой пуста
/// по определению. Два потока — две таблицы, и каждая отвечает на свой вопрос;
/// сводит их обзор (`GET /accounting/overview`), а не схема.
///
/// Своей суммы «к оплате» у расхода нет: он либо проведён, либо нет. Поэтому
/// ни статуса, ни остатка здесь не появляется — в отличие от начисления
/// студенту (0029), где месяц закрывается платежами.
model Expense {
  id String @id @default(uuid()) @db.Uuid

  categoryId String          @db.Uuid
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Назначение платежа («Аренда за сентябрь», «Таргет в Instagram»).
  /// Обязательно: расход без названия в отчёте через полгода неотличим
  /// от ошибки ввода — тот же довод, что у причины скидки (0029).
  title String

  /// Сумма в сомони. `Decimal`, как и вся касса (0029): из этих строк
  /// складывается «Income vs Expense» обзора.
  amount Decimal @db.Decimal(12, 2)

  /// День, когда деньги ушли (`@db.Date`, наружу — `YYYY-MM-DD`). Отдельно
  /// от `createdAt`: расход заводят задним числом, и в отчёт он должен попасть
  /// по дате платежа, а не по дате ввода.
  spentAt DateTime @db.Date

  /// Филиал, на который отнесён расход (ТЗ 3.3: разрез по филиалам сквозной).
  /// Необязателен: аренда сервера и налоги общие для центра, и приписывать
  /// их одному филиалу значило бы искажать его отчёт.
  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  note String?

  /// Кто провёл расход. `SET NULL`, как у всей кассы (0029).
  createdById String?   @db.Uuid
  createdBy   Employee? @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Расходы за период — основной отбор и списка, и обзора.
  @@index([spentAt])
  /// Свод по категориям за период (ТЗ 5.16) и опора под `RESTRICT`.
  @@index([categoryId, spentAt])
  /// Разрез по филиалам и опора под `RESTRICT` на филиал.
  @@index([branchId])
  @@map("expenses")
}

/// Состояние плана (ТЗ 5.16: «Budget: … период, статус»).
///
/// Перечисления ТЗ не даёт, и общий `DirectoryStatus` сюда не подошёл: у плана
/// три состояния, а не два (решение пользователя, сессия 0031). `ACTIVE`
/// и `INACTIVE` не различают «ещё не утверждён» и «уже отработан», а это
/// разные вещи: первый правят, второй читают как снимок принятого решения.
enum BudgetStatus {
  /// Черновик: план составляется, цифры ещё двигаются.
  DRAFT
  /// Утверждён и действует — по нему сверяют расходы.
  ACTIVE
  /// Период закрыт, план больше не правится. Тот же ход, что с финализацией
  /// недели (0018) и закрытием месяца (0024): снимок появляется тогда,
  /// когда его сняли.
  CLOSED
}

/// План расходов на период (ТЗ 5.16: «Budget: план по категориям —
/// allocated/spent, период, статус»).
///
/// **`spent` здесь не хранится.** Он выводится из тех же `Expense`, что
/// и «Income vs Expense» обзора: план говорит, сколько собирались потратить,
/// а сколько потратили на самом деле, уже записано расходами. Вторая копия
/// того же числа требовала бы пересчёта при каждой правке расхода, а забытый
/// пересчёт всплыл бы не отказом, а тихо неверным отчётом — седьмой раз тот же
/// разбор после `Enrollment` (0012), `Performance` (0019), `LeftCourse` (0025),
/// `Certificate` (0026), `Debtor` (0029) и `Transaction` (0030).
///
/// Период задаётся **месяцами** (обе границы включительно, хранятся первыми
/// числами) — как во всех отчётах проекта начиная с истории уровней (0021).
/// Периоды разных бюджетов пересекаться могут: годовой план и план кампании
/// на март — законная пара, и запрет был бы выдуманным правилом. Каждый бюджет
/// считает `spent` по **своему** окну и отвечает на свой вопрос.
model Budget {
  id String @id @default(uuid()) @db.Uuid

  /// Название («Бюджет на I квартал 2026»). Уникально без учёта регистра —
  /// проверку делает сервис, как во всех справочниках проекта.
  name        String  @unique
  description String?

  /// Первый и последний месяцы периода — первые числа (`@db.Date`), наружу
  /// `YYYY-MM`. Обе границы включающие; правая уходит в запрос расходов первым
  /// числом следующего месяца, чтобы не выводить самому, сколько дней
  /// в последнем (приём 0025).
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  status BudgetStatus @default(DRAFT)

  /// Строки плана. `CASCADE`: строка вне бюджета адресовать нечем — она часть
  /// целого, а не самостоятельная запись (та же граница, что между уроком
  /// и его материалами, 0009).
  lines BudgetCategory[]

  /// Сколько выделено на фонд оплаты труда, в сомони (ТЗ 5.16).
  ///
  /// **Поле документа, а не строка по статье расхода** — и это прямое
  /// следствие решения сессии 0032: зарплата не заводит `Expense`, потому что
  /// выплата уже записана в `SalaryTransaction`, и вторая копия того же числа
  /// была бы восьмым «вторым источником истины» подряд. Раз зарплата не расход,
  /// планировать её строкой `BudgetCategory` было бы нечем: у строки плана
  /// обязательно есть статья.
  ///
  /// `null` — фонд оплаты труда в этом плане не планировали, и тогда он в план
  /// **не входит** (тот же довод, что у расхода по незапланированной статье:
  /// выдуманная строка утверждала бы, что статью планировали). `spent` для него
  /// не хранится, а считается по выплатам периода — как и весь остальной
  /// `spent` бюджета (0031).
  salaryAllocated Decimal? @db.Decimal(12, 2)

  /// Кто составил план. `SET NULL`, как у всей бухгалтерии (0029, 0030).
  createdById String?   @db.Uuid
  createdBy   Employee? @relation("BudgetAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Фильтр по состоянию: экран открывают на действующих планах.
  @@index([status])
  /// Бюджеты, пересекающиеся с периодом отчёта.
  @@index([periodFrom, periodTo])
  @@map("budgets")
}

/// Строка плана: сколько выделено на статью расхода (ТЗ 5.16: «allocated»).
///
/// Статья может быть и разделом верхнего уровня, и подкатегорией — справочник
/// двухуровневый (0030). План по разделу («Налоги») собирает расходы **всех
/// своих подкатегорий**: иначе «сколько выделено на налоги» пришлось бы
/// расписывать по четырём строкам, ради чего справочник и сделан двухуровневым.
/// Отсюда правило сервиса: раздел и его подкатегория **не встают в один бюджет
/// двумя строками** (422) — расход по НДС попал бы в обе, и сумма строк плана
/// перестала бы что-либо значить.
model BudgetCategory {
  id String @id @default(uuid()) @db.Uuid

  budgetId String @db.Uuid
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  categoryId String          @db.Uuid
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Сколько выделено на статью, в сомони. `Decimal`, как и вся касса (0029):
  /// это число сравнивают с суммой расходов, а двоичная плавающая точка дала бы
  /// копейку перерасхода на ровном плане.
  allocated Decimal @db.Decimal(12, 2)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Одна строка на статью внутри бюджета: две означали бы два плана на одно
  /// и то же, и «сколько выделено» перестало бы иметь единственный ответ.
  @@unique([budgetId, categoryId])
  /// Обратный обход «в каких планах эта статья» и опора под `RESTRICT`.
  @@index([categoryId])
  @@map("budget_categories")
}

/// Состояние расчёта зарплаты (ТЗ 5.16: «подтверждение Done»).
enum SalaryStatus {
  /// Черновик: часы и ставка **выводятся** из журнала и уровня месяца
  /// при каждом чтении, поэтому правка журнала задним числом сразу видна.
  DRAFT
  /// «Done» из ТЗ 5.16: расчёт согласован, его числа заморожены снимком
  /// и больше не меняются. Тот же ход, что с финализацией недели (0018),
  /// закрытием месяца рейтинга (0024), выпуском (0026) и начислением
  /// студенту (0029): снимок появляется тогда, когда его сняли.
  DONE
}

/// Расчёт зарплаты сотрудника за месяц (ТЗ 5.16: «Salary: Total/Prepaid/
/// Remaining/Paid; часы × часовая ставка уровня месяца + Bonus,
/// подтверждение Done»).
///
/// **Из четырёх чисел ТЗ здесь не хранится ни одно, пока расчёт в черновике:**
///   - `Total` = часы из журнала × ставка уровня месяца (0021) + `bonus`;
///   - `Prepaid` = одобренные заявки на аванс этого месяца (0022, 0031);
///   - `Paid` = сумма `SalaryTransaction` этого расчёта;
///   - `Remaining` = `Total − Prepaid − Paid`.
///
/// Все они выводятся из уже существующих записей, и хранить их значило бы
/// пересчитывать в каждом месте, где правят журнал, уровень или аванс.
/// Строка существует ради того, чего вывести неоткуда: `bonus`, `note`,
/// состояние и подпись подтвердившего.
///
/// При подтверждении (`DONE`) часы, ставка и итог **замораживаются** снимком:
/// после этого правка журнала или ставки справочника (а она по решению 0021
/// действует задним числом на все месяцы) не должна двигать сумму, которую
/// человеку уже назвали и, возможно, выплатили. Ровно тот же довод, по которому
/// `MonthlyWinner` — таблица, а `Performance` — нет.
///
/// `DailySalary` из карты сущностей ТЗ 4 **не заводится**: дневная строка —
/// это учебный день журнала, где ведущий равен этому сотруднику, а «часы ×
/// ставка» считается по нему на лету. Вторая таблица была бы копией журнала —
/// восьмой раз тот же разбор после `Enrollment` (0012), `Performance` (0019),
/// `LeftCourse` (0025), `Certificate` (0026), `Debtor` (0029), `Transaction`
/// (0030) и `StudentActivityCategory` (0024).
model Salary {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation("SalaryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Месяц зарплаты — первое число (`@db.Date`), наружу `YYYY-MM`. Тот же
  /// формат и тот же `parseIsoMonth`, что у истории уровней (0021) и заявки
  /// на аванс (0022): по этому месяцу расчёт и находит ставку с авансами.
  month DateTime @db.Date

  /// Премия за месяц (ТЗ 5.16: «+ Bonus»). Единственное слагаемое `Total`,
  /// которому больше негде жить: в журнале его нет, в справочнике тоже.
  bonus Decimal @default(0) @db.Decimal(12, 2)

  note String?

  status SalaryStatus @default(DRAFT)

  /// Снимок на момент подтверждения. `null`, пока расчёт в черновике, — и это
  /// не «ноль», а «снимка ещё нет»: черновик считается по живым данным
  /// (тот же смысл `null`, что у `averageScore` в 0019 и месяца без уровня
  /// в 0021).
  ///
  /// Минуты, а не часы: часы — это минуты, делённые на 60, и хранить результат
  /// деления значило бы терять остаток на каждой строке.
  minutes    Int?
  hourlyRate Decimal? @db.Decimal(12, 2)
  total      Decimal? @db.Decimal(12, 2)

  confirmedAt   DateTime?
  confirmedById String?   @db.Uuid
  confirmedBy   Employee? @relation("SalaryConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  createdById String?   @db.Uuid
  createdBy   Employee? @relation("SalaryAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Выплаты по этому расчёту. `RESTRICT` с их стороны: расчёт, по которому
  /// уже платили, не удаляется — иначе выплата повисла бы без месяца
  /// (то же правило, что у начисления студенту с платежами, 0029).
  transactions SalaryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Один расчёт на сотрудника в месяц. **Последний рубеж действительно
  /// в БД**, как у автоначисления коинов (0018), снимка месяца (0024)
  /// и начисления студенту (0029): две строки о зарплате одного месяца
  /// означали бы две выплаты, а вернуть их нечем.
  @@unique([employeeId, month])
  /// Ведомость месяца читается целиком и с фильтром по состоянию.
  @@index([month, status])
  @@index([employeeId])
  @@map("salaries")
}

/// Выплата по расчёту зарплаты (ТЗ 5.16: «Paid»).
///
/// Отдельная таблица, а не колонка `paidAmount` в расчёте: зарплату выдают
/// частями (аванс наличными, остаток переводом), и способ оплаты у каждой части
/// свой — ровно как у платежей студента (0029). Из этих же строк обзор и бюджет
/// узнают, сколько центр потратил на людей: `Expense` выплата **не заводит**
/// (решение пользователя, 0032) — вторая запись о тех же деньгах требовала бы
/// снимать её при каждой отмене выплаты, а забытое снятие всплыло бы не отказом,
/// а тихо завышенным расходом.
model SalaryTransaction {
  id String @id @default(uuid()) @db.Uuid

  salaryId String @db.Uuid
  salary   Salary @relation(fields: [salaryId], references: [id], onDelete: Restrict)

  /// Выплаченная сумма в сомони. `Decimal`, как вся касса (0029).
  amount Decimal @db.Decimal(12, 2)

  /// День выплаты (`@db.Date`, наружу `YYYY-MM-DD`). Отдельно от месяца
  /// расчёта: зарплату за сентябрь выдают в октябре, и в «Income vs Expense»
  /// она обязана попасть по дню, когда деньги ушли (приём 0030).
  paidAt DateTime @db.Date

  /// Способ выплаты — общий справочник с приходом (ТЗ 5.16: «Cash/Alif»).
  /// `RESTRICT`: способ, которым уже платили, не удаляется.
  typeId String      @db.Uuid
  type   PaymentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  comment String?

  createdById String?   @db.Uuid
  createdBy   Employee? @relation("SalaryTransactionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Выплаты расчёта — их сумма и есть `Paid`.
  @@index([salaryId])
  /// «Сколько центр выплатил за период» — обзор и бюджет читают отрезком дат.
  @@index([paidAt])
  @@index([typeId])
  @@map("salary_transactions")
}

/// Состояние финансового периода (ТЗ 5.16: «закрытие Inprogress→Archive»).
enum AccountingPeriodStatus {
  /// «Inprogress» из ТЗ: период ведётся, числа отчёта считаются на лету
  /// и меняются вместе с кассой.
  IN_PROGRESS
  /// «Archive» из ТЗ: период закрыт. Числа заморожены снимком, а сам период
  /// **не принимает операции, датированные внутри него**.
  ARCHIVED
}

/// Финансовый период-отчёт (ТЗ 5.16: «Accountant: финансовые периоды-отчёты
/// income/expense/paid/notpaid/net, закрытие Inprogress→Archive, выгрузка»).
///
/// Документ с собственным периодом, а не строка на календарный месяц (решение
/// пользователя, 0033): ТЗ даёт маршрут `POST /accounting/periods/{id}/close`,
/// то есть у периода есть свой идентификатор, а сдают отчётность и месяцем,
/// и кварталом, и годом. Границы — месяцы (первые числа, обе включительно),
/// как во всех отчётах проекта начиная с истории уровней (0021).
///
/// **Периоды не пересекаются** — осознанно иначе, чем бюджеты (0031). План
/// отвечает на вопрос «сколько собирались потратить», и годовой план рядом
/// с планом кампании законен; отчёт отвечает на вопрос «сколько центр
/// заработал», и один платёж, попавший в два отчёта, дал бы два ответа
/// на него. Проверку делает сервис (422 с названием мешающего периода):
/// в схеме это выражалось бы только exclusion-ограничением, которого Prisma
/// не строит.
///
/// **Закрытие замораживает снимок** (решение пользователя, 0033) — пятый снимок
/// проекта после `MonthlyWinner` (0024), `mentorAtLeaveId` (0025),
/// `Graduate.points` (0026) и подтверждения зарплаты (0032), и по той же
/// причине: отчёт, который уже сдали, не должен меняться от правки расхода
/// задним числом. У периода `IN_PROGRESS` все пять колонок снимка `null`,
/// и числа считаются агрегатами.
///
/// Хранятся только **первичные** числа: «долг» и «итог» из них выводятся
/// теми же функциями (`totalsOf`, вычитание в тыйинах), что и у живого
/// периода, — поэтому архивный и текущий отчёты не могут разойтись в способе
/// счёта, а колонка не становится вторым источником истины внутри своей же
/// строки.
model AccountingPeriod {
  id String @id @default(uuid()) @db.Uuid

  /// Название отчёта («III квартал 2026», «Сентябрь 2026»). Уникально
  /// без учёта регистра — проверку делает сервис, как во всех справочниках.
  name        String  @unique
  description String?

  /// Первый и последний месяцы периода — первые числа (`@db.Date`), наружу
  /// `YYYY-MM`. Обе границы включающие; правая уходит в запросы первым числом
  /// следующего месяца, чтобы не выводить самому, сколько дней в последнем
  /// (приём 0025, 0031).
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  status AccountingPeriodStatus @default(IN_PROGRESS)

  /// Снимок отчёта, снятый при закрытии. Все пять — `null` у периода в работе.
  ///
  /// `charged`/`paid` считаются по **месяцам обучения** (это план), `income`
  /// и `salary` — по дню, когда деньги пришли и ушли (это касса): различие,
  /// заданное решением 0030, здесь замораживается вместе с числами.
  ///
  /// Ширина `DECIMAL(14,2)`, а не `(12,2)` как у отдельных сумм: здесь лежит
  /// **итог за год по всему центру**, то есть сложение тысяч строк, и потолок
  /// одной операции (`MAX_MONEY_AMOUNT`) их сумму не ограничивает.
  charged Decimal? @db.Decimal(14, 2)
  paid    Decimal? @db.Decimal(14, 2)
  income  Decimal? @db.Decimal(14, 2)
  expense Decimal? @db.Decimal(14, 2)
  salary  Decimal? @db.Decimal(14, 2)

  /// Кто и когда закрыл период. `SET NULL` на сотрудника — как у всей
  /// бухгалтерии (0029–0032).
  closedAt   DateTime?
  closedById String?   @db.Uuid
  closedBy   Employee? @relation("AccountingPeriodCloser", fields: [closedById], references: [id], onDelete: SetNull)

  createdById String?   @db.Uuid
  createdBy   Employee? @relation("AccountingPeriodAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Главный запрос раздела и всей защиты от правок задним числом: «есть ли
  /// архивный период, накрывающий этот месяц». Статус первым — он отсекает
  /// большую часть строк.
  @@index([status, periodFrom, periodTo])
  /// Отбор по пересечению отрезков в списке и проверка непересечения.
  @@index([periodFrom, periodTo])
  @@map("accounting_periods")
}

